model_catalog_json = "{catalog}"
model = "{parent_model}"
model_reasoning_effort = "medium"

[model_providers.openai-chatgpt]
name = "CLIProxyAPI OpenAI Parent"
wire_api = "responses"
requires_openai_auth = false
base_url = "{CLIPROXY_CANARY_URL}"
experimental_bearer_token = "{CLIPROXY_CANARY_KEY}"

[model_providers.cliproxy-deepseek]
name = "CLIProxyAPI DeepSeek Alias"
wire_api = "responses"
requires_openai_auth = false
base_url = "{CLIPROXY_CANARY_URL}"
experimental_bearer_token = "{CLIPROXY_CANARY_KEY}"

[agents]
enabled = true
max_concurrent_threads_per_session = 2
'''
        (isolated_home / "config.toml").write_text(config_text, encoding="utf-8")
        os.chmod(isolated_home / "config.toml", 0o600)
        role_text = f'''name = "explorer"
description = "Read-only DeepSeek canary through a Codex-safe CLIProxyAPI alias."
model_provider = "cliproxy-deepseek"
model = "{CLIPROXY_ALIAS}"
model_reasoning_effort = "medium"
sandbox_mode = "read-only"
developer_instructions = "Use shell tools for the bounded task and return only the requested strict JSON."
'''
        (isolated_agents / "explorer.toml").write_text(role_text, encoding="utf-8")
        command = [
            str(codex),
            "--strict-config",
            "-c", "features.multi_agent=true",
            "-c", "features.multi_agent_v2=true",
            "exec",
            "--skip-git-repo-check",
            "--sandbox", "read-only",
            "--json",
            prompt,
        ]
        isolated_env = dict(os.environ)
        isolated_env["CODEX_HOME"] = str(isolated_home)
        canary_started_ms = int(time.time() * 1000) - 1000
        completed = invoke_codex(command, isolated_workspace, timeout, env=isolated_env)
        child_result, child_id, spawned, waited, nonce_verified = native_v1_child_result(completed.stdout, nonce)
        discovered = find_isolated_native_child(
            isolated_home,
            "cliproxy-deepseek",
            CLIPROXY_ALIAS,
            "explorer",
            canary_started_ms,
            nonce,
        )
        discovered_child = discovered["child"]
        if child_id is None and discovered_child:
            child_id = discovered_child["id"]
        child_metadata = discovered_child or native_child_metadata(isolated_home, child_id)
        rollout_path = discovered_child.get("rollout_path") if discovered_child else None
        rollout_evidence = child_rollout_evidence(
            isolated_home,
            child_id,
            nonce,
            rollout_path,
            expected_summary,
            (hidden_a, hidden_b),
        )
        if rollout_evidence["final_result"] is not None:
            child_result = rollout_evidence["final_result"]
            nonce_verified = rollout_evidence["final_result_nonce_verified"]
        spawn_inferred_from_state = bool(waited and discovered_child and rollout_evidence["task_payload_present"])
        spawned = spawned or spawn_inferred_from_state
        isolated_state_created = any(isolated_home.glob("state_*.sqlite"))
    proxy_response_requests = 0
    if log_path.is_file() and log_path.stat().st_size >= log_offset:
        with log_path.open("rb") as handle:
            handle.seek(log_offset)
            proxy_response_requests = handle.read().count(b'POST    "/v1/responses"')
    proxy_completed = proxy_response_requests >= 2
    config_unchanged = config_before == file_fingerprint(CONFIG_PATH)
    state_db_unchanged = state_before == state_db_snapshot()
    metadata_valid = bool(
        child_metadata
        and child_metadata.get("model_provider") == "cliproxy-deepseek"
        and child_metadata.get("model") == CLIPROXY_ALIAS
        and str(child_metadata.get("agent_role", "")).lower() == "explorer"
    )
    errors: list[str] = []
    warnings: list[str] = []
    combined_output = completed.stdout + "\n" + completed.stderr
    if completed.returncode != 0:
        errors.append(redact(completed.stderr or completed.stdout, 300))
    if "Unknown model" in combined_output:
        errors.append("unknown model")
    if not spawned:
        errors.append("native V2 spawn event not completed")
    if not waited:
        errors.append("native V2 wait event not completed")
    if child_result is None or not nonce_verified:
        errors.append("direct child result did not contain the assigned nonce contract")
    if not rollout_evidence["task_payload_present"]:
        errors.append("child rollout did not contain the assigned task nonce")
    if not rollout_evidence["tool_calls"] or rollout_evidence["tool_outputs"] < 1:
        errors.append("child rollout did not contain a completed shell tool exchange")
    if not rollout_evidence["expected_outputs_verified"]:
        errors.append("child shell outputs did not contain both hidden challenge tokens")
    if not proxy_completed:
        errors.append("CLIProxyAPI did not record the child Responses request")
    if not metadata_valid:
        errors.append("isolated state DB did not confirm the alias provider/model/role")
    if not isolated_state_created:
        errors.append("canary did not create an isolated state DB")
    if not config_unchanged:
        errors.append("live Codex config changed during canary")
    if not state_db_unchanged:
        warnings.append("live Codex state DB changed concurrently; canary state remained isolated")
    if not rollout_evidence["parallel_tool_calls_observed"]:
        warnings.append("parallel child tool calls were not observed in this run")
    return {
        "status": "success" if completed.returncode == 0 and not errors else "blocked",
        "protocol": "v2",
        "parent_model": parent_model,
        "child_model_alias": CLIPROXY_ALIAS,
        "root_model_provider": root_provider,
        "spawned": spawned,
        "spawn_inferred_from_state": spawn_inferred_from_state,
        "waited": waited,
        "child_result_valid": child_result is not None,
        "nonce_verified": nonce_verified,
        "task_payload_present": rollout_evidence["task_payload_present"],
        "tool_calls": rollout_evidence["tool_calls"],
        "tool_outputs": rollout_evidence["tool_outputs"],
        "hidden_outputs_verified": rollout_evidence["expected_outputs_verified"],
        "parallel_tool_calls_observed": rollout_evidence["parallel_tool_calls_observed"],
        "proxy_completed": proxy_completed,
        "proxy_response_requests": proxy_response_requests,
        "child_metadata_valid": metadata_valid,
        "child_candidate_count": discovered["candidate_count"],
        "state_db_isolated": isolated_state_created,
        "config_unchanged": config_unchanged,
        "state_db_unchanged": state_db_unchanged,
        "errors": errors,
        "warnings": warnings,
        "diagnostics": native_event_diagnostics(completed.stdout),
    }


def bridge_health(port: int) -> dict[str, Any]:
    url = f"http://127.0.0.1:{port}/v1/health"
    try:
        with urllib.request.urlopen(url, timeout=3) as response:
            payload = json.loads(response.read().decode())
        return {"ok": response.status == 200 and payload.get("status") == "ok", "url": url}
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        return {"ok": False, "url": url, "error": type(exc).__name__}


