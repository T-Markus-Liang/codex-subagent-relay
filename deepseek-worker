def workspace_snapshot(workdir: Path) -> dict[str, str]:
    """Fingerprint every dirty or untracked path, including files already dirty before a run."""
    try:
        result = subprocess.run(
            ["git", "-C", str(workdir), "status", "--porcelain=v1", "-z", "--untracked-files=all"],
            capture_output=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if result.returncode != 0:
        return filesystem_snapshot(workdir)
    records = result.stdout.split(b"\0")
    paths: list[str] = []
    index = 0
    while index < len(records):
        record = records[index]
        index += 1
        if len(record) < 4:
            continue
        status = record[:2]
        paths.append(os.fsdecode(record[3:]))
        if b"R" in status or b"C" in status:
            index += 1

    snapshot: dict[str, str] = {}
    for relative in paths:
        path = workdir / relative
        try:
            if path.is_symlink():
                snapshot[relative] = f"symlink:{os.readlink(path)}"
            elif path.is_file():
                snapshot[relative] = str(file_fingerprint(path)["sha256"])
            elif path.exists():
                snapshot[relative] = "other"
            else:
                snapshot[relative] = "deleted"
        except OSError:
            snapshot[relative] = "unreadable"
    return snapshot


def filesystem_snapshot(workdir: Path) -> dict[str, str]:
    """Bounded fallback for temporary/non-Git workdirs used by smoke tasks."""
    snapshot: dict[str, str] = {}
    skipped_dirs = {".git", ".venv", "node_modules", "__pycache__", ".mypy_cache", ".pytest_cache"}
    for root, directories, files in os.walk(workdir):
        directories[:] = [name for name in directories if name not in skipped_dirs and not name.startswith(".")]
        for name in files:
            path = Path(root) / name
            try:
                relative = str(path.relative_to(workdir))
                if path.is_symlink():
                    snapshot[relative] = f"symlink:{os.readlink(path)}"
                elif path.is_file():
                    snapshot[relative] = str(file_fingerprint(path)["sha256"])
                if len(snapshot) > MAX_FALLBACK_SNAPSHOT_FILES:
                    return {}
            except OSError:
                snapshot[str(path.relative_to(workdir))] = "unreadable"
    return snapshot


def workdir_lock(workdir: Path):
    """Serialize write workers targeting the same repository without blocking reads."""
    lock_key = hashlib.sha256(str(workdir).encode("utf-8")).hexdigest()[:24]
    lock_path = CODEX_HOME / "deepseek-worker-locks" / f"{lock_key}.lock"
    lock_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = lock_path.open("a+", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        handle.close()
        raise WorkerError("another write worker is already active for this workdir") from exc
    handle.seek(0)
    handle.truncate()
    handle.write(json.dumps({"workdir": str(workdir), "pid": os.getpid()}, separators=(",", ":")))
    handle.flush()
    return handle


