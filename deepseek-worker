        rollout_evidence = child_rollout_evidence(
            isolated_home,
            child_id,
            nonce,
            expected_summary=expected_summary,
            expected_outputs=(hidden_a, hidden_b),
        )
        isolated_state_created = any(isolated_home.glob("state_*.sqlite"))
    provider_completed = bridge_provider_completed(BRIDGE_LOG_PATH, log_offset, provider)
    diagnostics = native_event_diagnostics(completed.stdout)
    config_unchanged = config_before == file_fingerprint(CONFIG_PATH)
    state_db_unchanged = state_before == state_db_snapshot()
    metadata_valid = bool(
        child_metadata
        and child_metadata.get("model_provider") == provider
        and child_metadata.get("model") == "deepseek-v4-flash"
        and str(child_metadata.get("agent_role", "")).lower() == agent_type.lower()
    )
    errors: list[str] = []
    warnings: list[str] = []
    combined_output = completed.stdout + "\n" + completed.stderr
    if completed.returncode != 0:
        errors.append(redact(completed.stderr or completed.stdout, 300))
    if "Unknown model" in combined_output:
        errors.append("unknown model")
    if not spawned:
        errors.append("native V1 spawn event not completed")
    if not waited:
        errors.append("native V1 wait event not completed")
    if child_result is None or not nonce_verified:
        errors.append("wait event did not contain the assigned direct child result contract")
    if not rollout_evidence["task_payload_present"]:
        errors.append("child rollout did not contain the assigned task nonce")
    if not rollout_evidence["tool_calls"] or rollout_evidence["tool_outputs"] < 2:
        errors.append("child rollout did not contain both completed shell tool exchanges")
    if not rollout_evidence["parallel_tool_calls_observed"]:
        errors.append("child rollout did not show parallel shell tool calls")
    if not rollout_evidence["expected_outputs_verified"]:
        errors.append("child shell outputs did not contain both hidden challenge tokens")
    if not rollout_evidence["final_result_valid"] or not rollout_evidence["final_result_nonce_verified"]:
        errors.append("child rollout did not contain the assigned final result contract")
    if not provider_completed:
        errors.append(f"bridge did not record completion for {provider}")
    if not metadata_valid:
        errors.append("isolated state DB did not confirm the expected child provider/model/role")
    if not isolated_state_created:
        errors.append("native V1 tool canary did not create an isolated state DB")
    if not config_unchanged:
        errors.append("Codex config changed during canary")
    if not state_db_unchanged:
        warnings.append("live Codex state DB changed concurrently; canary child state was confined to temporary CODEX_HOME")
    return {
        "status": "success" if completed.returncode == 0 and not errors else "blocked",
        "protocol": "v1-tool",
        "desktop_codex_version": desktop_version,
        "root_model_provider": root_provider,
        "parent_model": parent_model,
        "agent_type": agent_type,
        "role_layer": role_layer,
        "custom_role": custom_role,
        "expected_provider": provider,
        "spawned": spawned,
        "waited": waited,
        "child_result_valid": child_result is not None,
        "nonce_verified": nonce_verified,
        "task_payload_present": rollout_evidence["task_payload_present"],
        "tool_calls": rollout_evidence["tool_calls"],
        "tool_outputs": rollout_evidence["tool_outputs"],
        "hidden_outputs_verified": rollout_evidence["expected_outputs_verified"],
        "parallel_tool_calls_observed": rollout_evidence["parallel_tool_calls_observed"],
        "rollout_final_result_valid": rollout_evidence["final_result_valid"],
        "provider_completed": provider_completed,
        "child_metadata_valid": metadata_valid,
        "state_db_isolated": isolated_state_created,
        "config_unchanged": config_unchanged,
        "state_db_unchanged": state_db_unchanged,
        "errors": errors,
        "warnings": warnings,
        "diagnostics": diagnostics,
    }


def native_role_bisection(provider: str, workdir: Path, timeout: int, parent_model_override: str | None = None) -> dict[str, Any]:
    """Run explicit isolated role layers in order; this is research, never production routing."""
    results: list[dict[str, Any]] = []
    for layer in NATIVE_ROLE_LAYERS:
        result = native_v1_canary(provider, workdir, timeout, parent_model_override, role_layer=layer)
        results.append(result)
        # The first failed layer is the bisection result; do not create extra Provider traffic.
        if result.get("status") != "success":
            break
    first_failure = next((item.get("role_layer") for item in results if item.get("status") != "success"), None)
    return {
        "status": "success" if len(results) == len(NATIVE_ROLE_LAYERS) and all(item.get("status") == "success" for item in results) else "blocked",
        "protocol": "v1-role-bisection",
        "provider": provider,
        "parent_model": parent_model_override,
        "layers_attempted": [item["role_layer"] for item in results],
        "first_failing_layer": first_failure,
        "results": results,
        "production_eligible": False,
    }


def cliproxy_native_canary(workdir: Path, timeout: int, parent_model_override: str | None = None) -> dict[str, Any]:
    try:
        config = tomllib.load(CONFIG_PATH.open("rb"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
