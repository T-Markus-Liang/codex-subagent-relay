        "fork_turns field whose value is none. Give it this task "
        f"verbatim: <canary-task>{child_task}</canary-task> Wait for the child. Do not execute the child's shell "
        "commands yourself, and do not synthesize or repair its response. Return the child's response verbatim."
    )
    config_before = file_fingerprint(CONFIG_PATH)
    state_before = state_db_snapshot()
    log_path = CLIPROXY_CANARY_LOG_PATH
    log_offset = log_path.stat().st_size if log_path.is_file() else 0
    with tempfile.TemporaryDirectory(prefix="deepseek-cliproxy-v2-") as temporary_dir:
        temporary_root = Path(temporary_dir)
        isolated_home = temporary_root / "codex-home"
        isolated_agents = isolated_home / "agents"
        isolated_workspace = temporary_root / "workspace"
        isolated_agents.mkdir(parents=True)
        isolated_workspace.mkdir()
        hidden_a = secrets.token_hex(16)
        hidden_b = secrets.token_hex(16)
        (isolated_workspace / ".cliproxy-canary-a").write_text(hidden_a, encoding="utf-8")
        (isolated_workspace / ".cliproxy-canary-b").write_text(hidden_b, encoding="utf-8")
        expected_summary = f"cliproxy-native-canary:{hidden_a}:{hidden_b}"
        for auth_name in ("auth.json", "current_account"):
            auth_source = CODEX_HOME / auth_name
            if auth_source.is_file():
                (isolated_home / auth_name).symlink_to(auth_source)
        catalog = isolated_home / "models.json"
        build_cliproxy_canary_catalog(catalog_source, catalog, parent_model)
        config_text = f'''model_provider = "openai-chatgpt"
model_catalog_json = "{catalog}"
model = "{parent_model}"
model_reasoning_effort = "medium"

[model_providers.openai-chatgpt]
name = "CLIProxyAPI OpenAI Parent"
wire_api = "responses"
requires_openai_auth = false
base_url = "{CLIPROXY_CANARY_URL}"
experimental_bearer_token = "{CLIPROXY_CANARY_KEY}"

[model_providers.cliproxy-deepseek]
name = "CLIProxyAPI DeepSeek Alias"
wire_api = "responses"
requires_openai_auth = false
base_url = "{CLIPROXY_CANARY_URL}"
experimental_bearer_token = "{CLIPROXY_CANARY_KEY}"

[agents]
enabled = true
max_concurrent_threads_per_session = 2
'''
        (isolated_home / "config.toml").write_text(config_text, encoding="utf-8")
        os.chmod(isolated_home / "config.toml", 0o600)
        role_text = f'''name = "explorer"
description = "Read-only DeepSeek canary through a Codex-safe CLIProxyAPI alias."
model_provider = "cliproxy-deepseek"
model = "{CLIPROXY_ALIAS}"
model_reasoning_effort = "medium"
sandbox_mode = "read-only"
developer_instructions = "Use shell tools for the bounded task and return only the requested strict JSON."
'''
        (isolated_agents / "explorer.toml").write_text(role_text, encoding="utf-8")
        command = [
            str(codex),
            "--strict-config",
            "-c", "features.multi_agent=true",
            "-c", "features.multi_agent_v2=true",
            "exec",
            "--skip-git-repo-check",
            "--sandbox", "read-only",
            "--json",
            prompt,
        ]
        isolated_env = dict(os.environ)
        isolated_env["CODEX_HOME"] = str(isolated_home)
        canary_started_ms = int(time.time() * 1000) - 1000
        completed = invoke_codex(command, isolated_workspace, timeout, env=isolated_env)
        child_result, child_id, spawned, waited, nonce_verified = native_v1_child_result(completed.stdout, nonce)
        discovered = find_isolated_native_child(
            isolated_home,
            "cliproxy-deepseek",
            CLIPROXY_ALIAS,
            "explorer",
            canary_started_ms,
            nonce,
        )
        discovered_child = discovered["child"]
        if child_id is None and discovered_child:
            child_id = discovered_child["id"]
        child_metadata = discovered_child or native_child_metadata(isolated_home, child_id)
        rollout_path = discovered_child.get("rollout_path") if discovered_child else None
        rollout_evidence = child_rollout_evidence(
            isolated_home,
            child_id,
            nonce,
            rollout_path,
            expected_summary,
            (hidden_a, hidden_b),
        )
        if rollout_evidence["final_result"] is not None:
            child_result = rollout_evidence["final_result"]
            nonce_verified = rollout_evidence["final_result_nonce_verified"]
        spawn_inferred_from_state = bool(waited and discovered_child and rollout_evidence["task_payload_present"])
        spawned = spawned or spawn_inferred_from_state
        isolated_state_created = any(isolated_home.glob("state_*.sqlite"))
    proxy_response_requests = 0
    if log_path.is_file() and log_path.stat().st_size >= log_offset:
        with log_path.open("rb") as handle:
            handle.seek(log_offset)
            proxy_response_requests = handle.read().count(b'POST    "/v1/responses"')
    proxy_completed = proxy_response_requests >= 2
    config_unchanged = config_before == file_fingerprint(CONFIG_PATH)
    state_db_unchanged = state_before == state_db_snapshot()
    metadata_valid = bool(
        child_metadata
        and child_metadata.get("model_provider") == "cliproxy-deepseek"
        and child_metadata.get("model") == CLIPROXY_ALIAS
        and str(child_metadata.get("agent_role", "")).lower() == "explorer"
    )
    errors: list[str] = []
    warnings: list[str] = []
    combined_output = completed.stdout + "\n" + completed.stderr
    if completed.returncode != 0:
        errors.append(redact(completed.stderr or completed.stdout, 300))
    if "Unknown model" in combined_output:
        errors.append("unknown model")
    if not spawned:
        errors.append("native V2 spawn event not completed")
    if not waited:
        errors.append("native V2 wait event not completed")
    if child_result is None or not nonce_verified:
        errors.append("direct child result did not contain the assigned nonce contract")
    if not rollout_evidence["task_payload_present"]:
        errors.append("child rollout did not contain the assigned task nonce")
    if not rollout_evidence["tool_calls"] or rollout_evidence["tool_outputs"] < 1:
        errors.append("child rollout did not contain a completed shell tool exchange")
    if not rollout_evidence["expected_outputs_verified"]:
        errors.append("child shell outputs did not contain both hidden challenge tokens")
    if not proxy_completed:
        errors.append("CLIProxyAPI did not record the child Responses request")
    if not metadata_valid:
        errors.append("isolated state DB did not confirm the alias provider/model/role")
    if not isolated_state_created:
        errors.append("canary did not create an isolated state DB")
    if not config_unchanged:
        errors.append("live Codex config changed during canary")
    if not state_db_unchanged:
        warnings.append("live Codex state DB changed concurrently; canary state remained isolated")
    if not rollout_evidence["parallel_tool_calls_observed"]:
        warnings.append("parallel child tool calls were not observed in this run")
    return {
        "status": "success" if completed.returncode == 0 and not errors else "blocked",
        "protocol": "v2",
        "parent_model": parent_model,
        "child_model_alias": CLIPROXY_ALIAS,
        "root_model_provider": root_provider,
        "spawned": spawned,
        "spawn_inferred_from_state": spawn_inferred_from_state,
        "waited": waited,
        "child_result_valid": child_result is not None,
        "nonce_verified": nonce_verified,
        "task_payload_present": rollout_evidence["task_payload_present"],
        "tool_calls": rollout_evidence["tool_calls"],
        "tool_outputs": rollout_evidence["tool_outputs"],
        "hidden_outputs_verified": rollout_evidence["expected_outputs_verified"],
        "parallel_tool_calls_observed": rollout_evidence["parallel_tool_calls_observed"],
        "proxy_completed": proxy_completed,
        "proxy_response_requests": proxy_response_requests,
        "child_metadata_valid": metadata_valid,
        "child_candidate_count": discovered["candidate_count"],
        "state_db_isolated": isolated_state_created,
        "config_unchanged": config_unchanged,
        "state_db_unchanged": state_db_unchanged,
        "errors": errors,
        "warnings": warnings,
        "diagnostics": native_event_diagnostics(completed.stdout),
    }


def bridge_health(port: int) -> dict[str, Any]:
    url = f"http://127.0.0.1:{port}/v1/health"
    try:
        with urllib.request.urlopen(url, timeout=3) as response:
            payload = json.loads(response.read().decode())
        return {"ok": response.status == 200 and payload.get("status") == "ok", "url": url}
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        return {"ok": False, "url": url, "error": type(exc).__name__}


def doctor() -> dict[str, Any]:
    problems: list[str] = []
    checks: dict[str, Any] = {
        "codex_command": bool(subprocess.run(["sh", "-c", "command -v codex"], capture_output=True).returncode == 0),
        "opencode_command": OPENCODE_PATH.is_file() and os.access(OPENCODE_PATH, os.X_OK),
        "config_path": str(CONFIG_PATH),
        "result_schema": SCHEMA_PATH.is_file(),
        "profiles": {},
        "bridges": {},
        "candidate_catalog": {"path": str(DEFAULT_CATALOG_PATH), "exists": DEFAULT_CATALOG_PATH.is_file()},
    }
    config: dict[str, Any] = {}
    try:
        config = tomllib.load(CONFIG_PATH.open("rb"))
        checks["root_model_provider"] = config.get("model_provider")
    except (OSError, tomllib.TOMLDecodeError) as exc:
        problems.append(f"config: {type(exc).__name__}")
    for provider, metadata in PROVIDERS.items():
        profile_path = CODEX_HOME / f"{metadata['profile']}.config.toml"
        valid = False
        try:
            with profile_path.open("rb") as handle:
                profile = tomllib.load(handle)
            valid = profile.get("model_provider") == provider and profile.get("model") == "deepseek-v4-flash"
        except (OSError, tomllib.TOMLDecodeError):
            pass
        checks["profiles"][provider] = {"ok": valid, "path": str(profile_path)}
        checks["bridges"][provider] = bridge_health(int(metadata["port"]))
        if not valid:
            problems.append(f"profile:{provider}")
        if not checks["bridges"][provider]["ok"]:
            problems.append(f"bridge:{provider}")
    models, model_error = get_model_ids()
    checks["native_model_registered"] = "deepseek-v4-flash" in models
    checks["model_catalog_error"] = model_error
    if not checks["codex_command"]:
        problems.append("codex command missing")
    if not checks["opencode_command"]:
        problems.append("opencode command missing")
    if checks.get("root_model_provider") != "openai-chatgpt":
        problems.append("root provider is not openai-chatgpt")
    return {
        "status": "healthy" if not problems else "degraded",
        "version": VERSION,
        "checks": checks,
        "problems": problems,
    }


def stats(hours: float) -> dict[str, Any]:
    cutoff = datetime.now(UTC) - timedelta(hours=hours)
    rows: list[dict[str, Any]] = []
    if RUN_LOG_PATH.is_file():
        for line in RUN_LOG_PATH.read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
                timestamp = datetime.fromisoformat(str(row["timestamp"]).replace("Z", "+00:00"))
            except (json.JSONDecodeError, KeyError, ValueError):
                continue
            if timestamp >= cutoff:
                rows.append(row)
    successes = sum(1 for row in rows if row.get("status") == "success")
    status_counts: dict[str, int] = {}
    by_provider: dict[str, int] = {}
    by_requested_provider: dict[str, int] = {}
    by_run_type: dict[str, dict[str, Any]] = {}
    provider_stats: dict[str, dict[str, Any]] = {}
    role_stats: dict[str, dict[str, Any]] = {}
    total_input = total_cached = total_cache_write = total_output = total_reasoning = 0
    durations: list[float] = []
    fallback_runs = partial_write_runs = stream_retry_runs = 0

    def add_aggregate(detail: dict[str, Any], row: dict[str, Any], status: str, duration: float) -> None:
        detail["runs"] += 1
        detail["status_counts"][status] = detail["status_counts"].get(status, 0) + 1
        detail["_durations"].append(duration)
        detail["fallback_runs"] += int(bool(row.get("fallback_used")))
        detail["partial_write_runs"] += int(bool(row.get("partial_write")))
        detail["stream_retry_runs"] += int(int(row.get("stream_retry_count") or 0) > 0)

    def aggregate() -> dict[str, Any]:
        return {
            "runs": 0,
            "status_counts": {},
            "_durations": [],
            "fallback_runs": 0,
            "partial_write_runs": 0,
            "stream_retry_runs": 0,
        }

    for row in rows:
        status = str(row.get("status", "unknown"))
        run_type = str(row.get("run_type", "external_run"))
        status_counts[status] = status_counts.get(status, 0) + 1
        provider = str(row.get("provider") or "unknown")
        by_provider[provider] = by_provider.get(provider, 0) + 1
        requested_provider = str(row.get("requested_provider") or "unknown")
        by_requested_provider[requested_provider] = by_requested_provider.get(requested_provider, 0) + 1
        duration = float(row.get("duration_seconds") or 0)
        durations.append(duration)
        fallback_runs += int(bool(row.get("fallback_used")))
        partial_write_runs += int(bool(row.get("partial_write")))
        stream_retry_runs += int(int(row.get("stream_retry_count") or 0) > 0)
        run_detail = by_run_type.setdefault(run_type, {"runs": 0, "successes": 0, "status_counts": {}})
        run_detail["runs"] += 1
        if status == "success":
            run_detail["successes"] += 1
        run_detail["status_counts"][status] = run_detail["status_counts"].get(status, 0) + 1
        usage = row.get("usage") or {}
        input_tokens = int(usage.get("input_tokens", 0))
        cached_input_tokens = int(usage.get("cached_input_tokens", 0))
        cache_write_input_tokens = int(usage.get("cache_write_input_tokens", 0))
        output_tokens = int(usage.get("output_tokens", 0))
        reasoning_output_tokens = int(usage.get("reasoning_output_tokens", 0))
        total_input += input_tokens
        total_cached += cached_input_tokens
        total_cache_write += cache_write_input_tokens
        total_output += output_tokens
        total_reasoning += reasoning_output_tokens
        detail = provider_stats.setdefault(provider, {
            **aggregate(),
            "success_rate_percent": 0.0,
            "duration_seconds": 0.0,
            "usage": {"input_tokens": 0, "cached_input_tokens": 0, "cache_write_input_tokens": 0, "output_tokens": 0, "reasoning_output_tokens": 0},
        })
        add_aggregate(detail, row, status, duration)
        detail["duration_seconds"] += duration
        role = str(row.get("role") or "unknown")
        add_aggregate(role_stats.setdefault(role, aggregate()), row, status, duration)
        for key, value in (("input_tokens", input_tokens), ("cached_input_tokens", cached_input_tokens), ("cache_write_input_tokens", cache_write_input_tokens), ("output_tokens", output_tokens), ("reasoning_output_tokens", reasoning_output_tokens)):
            detail["usage"][key] += value
    for detail in [*provider_stats.values(), *role_stats.values()]:
        duration_values = detail.pop("_durations")
        detail["p50_duration_seconds"] = percentile(duration_values, 0.5)
        detail["p95_duration_seconds"] = percentile(duration_values, 0.95)
        detail["success_rate_percent"] = round(100 * detail["status_counts"].get("success", 0) / detail["runs"], 2)
    for detail in provider_stats.values():
        detail["duration_seconds"] = round(detail["duration_seconds"], 2)
    unknown_attribution = sum(1 for row in rows if not row.get("provider") or not row.get("role"))
    return {
        "status": "success",
        "window_hours": hours,
        "runs": len(rows),
        "successes": successes,
        "success_rate_percent": round(100 * successes / len(rows), 2) if rows else 0.0,
        "by_provider": by_provider,
        "by_requested_provider": by_requested_provider,
        "by_run_type": by_run_type,
        "status_counts": status_counts,
        "provider_stats": provider_stats,
        "role_stats": role_stats,
        "reliability": {
            "p50_duration_seconds": percentile(durations, 0.5),
            "p95_duration_seconds": percentile(durations, 0.95),
            "fallback_runs": fallback_runs,
            "partial_write_runs": partial_write_runs,
            "stream_retry_runs": stream_retry_runs,
        },
        "coverage_warnings": (
            ["some run records lacked Provider or role attribution; those records are grouped under unknown"]
            if unknown_attribution
            else []
        ),
        "circuit": circuit_summary(),
        "usage": {
            "input_tokens": total_input,
            "cached_input_tokens": total_cached,
            "cache_write_input_tokens": total_cache_write,
            "output_tokens": total_output,
            "reasoning_output_tokens": total_reasoning,
            "request_tokens": total_input + total_output,
            "context_tokens": total_input + total_output + total_cached + total_cache_write,
        },
        "log_path": str(RUN_LOG_PATH),
    }


def parser() -> argparse.ArgumentParser:
    top = argparse.ArgumentParser(prog="deepseek-worker", description="Route and run bounded execution work through DeepSeek V4 Flash.")
    top.add_argument("--json", action="store_true", help="Emit stable JSON on stdout.")
    top.add_argument("--version", action="version", version=VERSION)
    commands = top.add_subparsers(dest="command", required=True)

    commands.add_parser("doctor", help="Check profiles, bridges, root provider, and native model registration.")

    catalog_parser = commands.add_parser("catalog-build", help="Build an isolated model catalog containing the live GPT list plus DeepSeek.")
    catalog_parser.add_argument("--out", default=str(DEFAULT_CATALOG_PATH))

    native_parser = commands.add_parser("native-check", help="Check whether an isolated profile registers DeepSeek in the Codex model catalog.")
    native_parser.add_argument("--profile", default=NATIVE_TEST_PROFILE)

    native_smoke_parser = commands.add_parser("native-smoke-test", help="Spawn one read-only native DeepSeek agent and verify provider attribution.")
    native_smoke_parser.add_argument("--agent", choices=("explorer", "worker", "default", "deepseek-worker"), default="deepseek-worker")
    native_smoke_parser.add_argument("--workdir", default=str(Path.cwd()))
    native_smoke_parser.add_argument("--timeout", type=int, default=180)

    native_v1_parser = commands.add_parser(
        "native-v1-canary",
        help="Run an isolated Desktop V1 canary and validate the direct child result and provider.",
    )
    native_v1_parser.add_argument("--provider", choices=tuple(PROVIDERS), default="sensenova")
    native_v1_parser.add_argument("--parent-model", help="Override the configured GPT parent for this isolated canary only.")
    native_v1_parser.add_argument("--workdir", default=str(Path.cwd()))
    native_v1_parser.add_argument("--timeout", type=int, default=180)
    native_v1_parser.add_argument("--role-layer", choices=NATIVE_ROLE_LAYERS, default="full", help="Use one isolated role-definition layer; production remains external.")

    native_v1_tool_parser = commands.add_parser(
        "native-v1-tool-canary",
        help="Run an isolated Desktop V1 canary that requires child shell tools, direct wait, and rollout evidence.",
    )
    native_v1_tool_parser.add_argument("--provider", choices=tuple(PROVIDERS), default="sensenova")
    native_v1_tool_parser.add_argument("--parent-model", help="Override the configured GPT parent for this isolated canary only.")
    native_v1_tool_parser.add_argument("--workdir", default=str(Path.cwd()))
    native_v1_tool_parser.add_argument("--timeout", type=int, default=180)
    native_v1_tool_parser.add_argument("--role-layer", choices=NATIVE_ROLE_LAYERS, default="full", help="Use one isolated role-definition layer; production remains external.")

    native_bisection_parser = commands.add_parser(
        "native-role-bisection",
        help="Explicitly bisect built-in, minimal, model-only, Provider-only, and full V1 role layers in disposable CODEX_HOME instances.",
    )
    native_bisection_parser.add_argument("--provider", choices=tuple(PROVIDERS), default="sensenova")
    native_bisection_parser.add_argument("--parent-model", help="Override the configured GPT parent for this isolated research matrix only.")
    native_bisection_parser.add_argument("--workdir", default=str(Path.cwd()))
    native_bisection_parser.add_argument("--timeout", type=int, default=180)

    cliproxy_parser = commands.add_parser(
        "cliproxy-native-canary",
        help="Run an isolated native V2 Agent Team canary through the CLIProxyAPI DeepSeek alias.",
    )
    cliproxy_parser.add_argument("--parent-model", default="gpt-5.6-sol")
    cliproxy_parser.add_argument("--workdir", default=str(Path.cwd()))
    cliproxy_parser.add_argument("--timeout", type=int, default=300)

    route_parser = commands.add_parser("route", help="Resolve a task role to Sol, Terra, or a DeepSeek provider without running a model.")
    route_parser.add_argument("--role", default="auto")
    route_parser.add_argument("--task", default="")

    def add_run_arguments(command_parser: argparse.ArgumentParser) -> None:
        command_parser.add_argument("--task")
        command_parser.add_argument("--task-file")
        command_parser.add_argument("--role", default="auto")
        command_parser.add_argument("--workdir", required=True)
        command_parser.add_argument("--provider", choices=("auto", *PROVIDERS), default="auto")
        command_parser.add_argument("--sandbox", choices=("auto", "read-only", "workspace-write"), default="auto")
        command_parser.add_argument(
            "--timeout",
            type=int,
            default=0,
            help="Seconds for the whole Worker run; 0 selects 75s read-only or 120s write/general defaults.",
        )
        command_parser.add_argument(
            "--idempotency-key",
            help="Opaque caller key (not retained in plaintext); reuses a matching job in the same workdir.",
        )
        command_parser.add_argument(
            "--telemetry-scope",
            choices=("production", "diagnostic", "qualification"),
            default="production",
            help="Operational classification only; qualification normally uses --no-record.",
        )
        command_parser.add_argument("--no-record", action="store_true")

    run_parser = commands.add_parser("run", help="Run one bounded execution task through a DeepSeek profile.")
    add_run_arguments(run_parser)

    launch_parser = commands.add_parser("launch", help="Start a Worker task and return a job id for non-blocking polling.")
    add_run_arguments(launch_parser)

    poll_parser = commands.add_parser("poll", help="Read a launched Worker task result without blocking.")
    poll_parser.add_argument("--job-id", required=True)

    status_parser = commands.add_parser("status", help="Read durable job metadata and terminal result without model access.")
    status_parser.add_argument("--job-id", required=True)

    cancel_parser = commands.add_parser("cancel", help="Cancel a running Worker job without replaying it.")
    cancel_parser.add_argument("--job-id", required=True)

    list_parser = commands.add_parser("list", help="List recent durable jobs without task text or raw output.")
    list_parser.add_argument("--limit", type=int, default=20)

    inspect_parser = commands.add_parser("inspect", help="Inspect one durable job's metadata, manifests, and bounded result.")
    inspect_parser.add_argument("--job-id", required=True)

    cleanup_parser = commands.add_parser("cleanup", help="Preview or remove expired terminal job artifacts; active jobs are always retained.")
    cleanup_parser.add_argument("--retention-hours", type=float, default=DEFAULT_TERMINAL_JOB_RETENTION_HOURS)
    cleanup_parser.add_argument("--apply", action="store_true", help="Actually delete eligible terminal job directories. Omit for a dry run.")
    cleanup_parser.add_argument(
        "--legacy-action",
        choices=("report", "archive"),
        default="report",
        help="Keep flat legacy artifacts reported by default; archive moves them into a private legacy directory only with --apply.",
    )

    smoke_parser = commands.add_parser("smoke-test", help="Run a tiny read-only live task through one provider.")
    smoke_parser.add_argument("--provider", choices=tuple(PROVIDERS), default="sensenova")
    smoke_parser.add_argument("--workdir", default=str(Path.cwd()))
    smoke_parser.add_argument("--timeout", type=int, default=120)
    smoke_parser.add_argument("--no-record", action="store_true")

    stats_parser = commands.add_parser("stats", help="Summarize worker runs without storing or reading task bodies.")
    stats_parser.add_argument("--hours", type=float, default=8.0)
    return top


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "doctor":
            payload = doctor()
        elif args.command == "catalog-build":
            payload = build_catalog(Path(args.out).expanduser().resolve())
        elif args.command == "native-check":
            payload = native_check(args.profile)
        elif args.command == "native-smoke-test":
            workdir = Path(args.workdir).expanduser().resolve()
            if not workdir.is_dir():
                raise WorkerError(f"workdir not found: {workdir}")
            payload = native_smoke(args.agent, workdir, args.timeout)
            record_run(payload, run_type="native_smoke_test", telemetry_scope="diagnostic")
        elif args.command == "native-v1-canary":
            workdir = Path(args.workdir).expanduser().resolve()
            if not workdir.is_dir():
                raise WorkerError(f"workdir not found: {workdir}")
            payload = native_v1_canary(args.provider, workdir, args.timeout, args.parent_model, args.role_layer)
            record_run(payload, run_type="native_v1_canary", telemetry_scope="diagnostic")
        elif args.command == "native-v1-tool-canary":
            workdir = Path(args.workdir).expanduser().resolve()
            if not workdir.is_dir():
                raise WorkerError(f"workdir not found: {workdir}")
            payload = native_v1_tool_canary(args.provider, workdir, args.timeout, args.parent_model, args.role_layer)
            record_run(payload, run_type="native_v1_tool_canary", telemetry_scope="diagnostic")
        elif args.command == "native-role-bisection":
            workdir = Path(args.workdir).expanduser().resolve()
            if not workdir.is_dir():
                raise WorkerError(f"workdir not found: {workdir}")
            payload = native_role_bisection(args.provider, workdir, args.timeout, args.parent_model)
            record_run(payload, run_type="native_role_bisection", telemetry_scope="diagnostic")
        elif args.command == "cliproxy-native-canary":
            workdir = Path(args.workdir).expanduser().resolve()
            if not workdir.is_dir():
                raise WorkerError(f"workdir not found: {workdir}")
            payload = cliproxy_native_canary(workdir, args.timeout, args.parent_model)
            record_run(payload, run_type="cliproxy_native_canary", telemetry_scope="diagnostic")
        elif args.command == "route":
            payload = {"status": "success", **route(args.role, args.task)}
        elif args.command == "run":
            payload = run_worker(args)
        elif args.command == "launch":
            payload = launch_worker(args)
        elif args.command == "poll":
            payload = poll_worker(args.job_id)
        elif args.command == "status":
            payload = poll_worker(args.job_id)
        elif args.command == "cancel":
            payload = cancel_worker(args.job_id)
        elif args.command == "list":
            payload = list_jobs(args.limit)
        elif args.command == "inspect":
            payload = inspect_job(args.job_id)
        elif args.command == "cleanup":
            payload = cleanup_terminal_jobs(args.retention_hours, args.apply, args.legacy_action)
        elif args.command == "smoke-test":
            run_args = argparse.Namespace(
                task="Inspect the current directory without modifying files. Reply with a short success summary.",
                task_file=None,
                role="repository-exploration",
                workdir=args.workdir,
                provider=args.provider,
                sandbox="read-only",
                timeout=args.timeout,
                no_record=args.no_record,
            )
            payload = run_worker(run_args)
        else:
            payload = stats(args.hours)
    except WorkerError as exc:
        payload = {"status": "error", "error": str(exc)}
        emit(payload, args.json)
        return 2
    except Exception as exc:  # Keep the CLI contract stable at the boundary.
        payload = {"status": "error", "error": type(exc).__name__}
        emit(payload, args.json)
        return 1
    emit(payload, args.json)
    return 0 if payload.get("status") not in {"error"} else 1


if __name__ == "__main__":
    raise SystemExit(main())
