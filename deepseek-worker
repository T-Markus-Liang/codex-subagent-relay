def emit(payload: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
        return
    status = payload.get("status", "unknown")
    summary = payload.get("summary") or payload.get("reason") or ""
    print(f"status: {status}")
    if summary:
        print(summary)


def redact(text: str, limit: int = 1200) -> str:
    compact = " ".join(text.strip().split())
    for marker in ("Bearer ", "sk-", "api_key=", "api-key="):
        pos = compact.lower().find(marker.lower())
        if pos >= 0:
            compact = compact[:pos] + "[REDACTED]"
            break
    return compact[-limit:]


def load_task(task: str | None, task_file: str | None) -> str:
    if bool(task) == bool(task_file):
        raise WorkerError("provide exactly one of --task or --task-file")
    if task_file:
        path = Path(task_file).expanduser().resolve()
        if not path.is_file():
            raise WorkerError(f"task file not found: {path}")
        if path.stat().st_size > MAX_TASK_BYTES:
            raise WorkerError(f"task file exceeds {MAX_TASK_BYTES} bytes")
        value = path.read_text(encoding="utf-8")
    else:
        value = task or ""
    if not value.strip():
        raise WorkerError("task is empty")
    return value.strip()


def normalize_role(role: str, task: str = "") -> str:
    value = role.strip().lower().replace("_", "-")
    if value != "auto":
        return value
    lowered = task.lower()
    keyword_groups = [
        (SOL_ROLES, ("architecture", "architect", "规划", "架构", "最终 review", "final review")),
        (TERRA_ROLES, ("second opinion", "validation", "review", "复核", "验证", "审查")),
        (READ_ONLY_ROLES, ("grep", "search", "explore", "日志分析", "代码搜索", "仓库探索")),
        (WORKER_ROLES, ("implement", "test", "debug", "refactor", "document", "实现", "测试", "调试", "重构", "文档")),
    ]
    for roles, keywords in keyword_groups:
        if any(word in lowered for word in keywords):
            return sorted(roles)[0]
    return "implementation"


def route(role: str, task: str = "") -> dict[str, Any]:
    normalized = normalize_role(role, task)
    if normalized in SOL_ROLES:
        return {"target": "sol", "role": normalized, "reason": "architecture_or_final_decision"}
    if normalized in TERRA_ROLES:
        return {"target": "terra", "role": normalized, "reason": "review_or_validation"}
