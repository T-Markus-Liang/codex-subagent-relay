def redact(text: str, limit: int = 1200) -> str:
    compact = " ".join(text.strip().split())
    for marker in ("Bearer ", "sk-", "api_key=", "api-key="):
        pos = compact.lower().find(marker.lower())
        if pos >= 0:
            compact = compact[:pos] + "[REDACTED]"
            break
    return compact[-limit:]


def percentile(values: list[float], fraction: float) -> float | None:
    if not values:
        return None
    ordered = sorted(values)
    index = min(len(ordered) - 1, max(0, round((len(ordered) - 1) * fraction)))
    return round(ordered[index], 2)


def redact_summary(summary: str, workdir: Path) -> str:
    """Keep model summaries useful while removing the task absolute workdir."""
    replacements = {str(workdir), str(workdir.resolve()), os.path.realpath(str(workdir))}
    if str(workdir).startswith("/private/"):
        replacements.add(str(workdir)[len("/private"):])
    elif str(workdir).startswith("/"):
        replacements.add("/private" + str(workdir))
    value = summary
    for path in sorted(replacements, key=len, reverse=True):
        value = value.replace(path, "[WORKDIR]")
    return value[:4000]


def load_task(task: str | None, task_file: str | None) -> str:
    if bool(task) == bool(task_file):
        raise WorkerError("provide exactly one of --task or --task-file")
    if task_file:
        path = Path(task_file).expanduser().resolve()
        if not path.is_file():
            raise WorkerError(f"task file not found: {path}")
        if path.stat().st_size > MAX_TASK_BYTES:
            raise WorkerError(f"task file exceeds {MAX_TASK_BYTES} bytes")
        value = path.read_text(encoding="utf-8")
    else:
        value = task or ""
    if not value.strip():
        raise WorkerError("task is empty")
    return value.strip()


