    parent_model = parent_model_override or "gpt-5.6-sol"
    if root_provider != "openai-chatgpt":
        raise WorkerError("CLIProxyAPI canary requires root model_provider=openai-chatgpt")
    catalog_source = Path(str(config.get("model_catalog_json", DEFAULT_CATALOG_PATH))).expanduser().resolve()
    codex = desktop_codex_binary()
    nonce = secrets.token_hex(16)
    child_task = (
        f"This is read-only CLIProxyAPI native Agent Team canary run {nonce}. Two files named .cliproxy-canary-a and "
        ".cliproxy-canary-b exist in your current working directory. Their contents are not included in this task. "
        "Use the shell tool to read them with exactly two independent commands in one parallel tool-use turn. "
        "Do not modify files. Return exactly one JSON object with no Markdown or surrounding prose and exactly "
        "these fields: status='success'; summary='cliproxy-native-canary:<content-a>:<content-b>'; "
        "files_changed=[]; tests=['parallel hidden tokens verified']; risks=[]. Replace both placeholders with the "
        "exact file contents. You cannot complete this task correctly without reading both files."
    )
    prompt = (
