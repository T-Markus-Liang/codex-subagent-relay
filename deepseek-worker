def build_provider_order(role: str, selected_provider: str, automatic: bool) -> list[str]:
    """Keep fallback traffic aligned with the task's read/write characteristics."""
    if not automatic:
        return [selected_provider]
    normalized = normalize_role(role)
    if normalized in READ_ONLY_ROLES:
        preferred = ("sensenova", "sensenova1")
    elif normalized in WORKER_ROLES:
        preferred = ("sensenova1", "sensenova")
    else:
        preferred = ("sensenova1", "sensenova")
    return [selected_provider, *(name for name in preferred if name != selected_provider)]


def provider_timeouts(total_timeout: int, attempts: int) -> list[int]:
    """Give the preferred route enough time to finish before bounded fallbacks."""
    total = max(30, int(total_timeout))
    if attempts <= 1:
        return [total]
    if total < 60:
        base, remainder = divmod(total, attempts)
        return [base + (1 if index < remainder else 0) for index in range(attempts)]
    reserve = min(45, max(20, total // 4))
    first = total - reserve
    fallback, remainder = divmod(reserve, attempts - 1)
    return [first, *(fallback + (1 if index < remainder else 0) for index in range(attempts - 1))]


def effective_timeout(requested_timeout: int, role: str) -> int:
    """Use short role-aware defaults unless a caller explicitly supplies a positive budget."""
    if requested_timeout > 0:
        return max(30, int(requested_timeout))
    normalized = normalize_role(role)
    if normalized in READ_ONLY_ROLES:
        return DEFAULT_READ_TIMEOUT
    if normalized in WORKER_ROLES:
        return DEFAULT_WRITE_TIMEOUT
    return DEFAULT_GENERAL_TIMEOUT


def worker_prompt(task: str, role: str) -> str:
    return f"""You are a bounded DeepSeek execution worker.

Role: {role}

Complete the task in the current work directory. Keep exploration, grep output, build logs,
stack traces, and intermediate debugging in this worker context. Do not return raw logs.
Make only task-scoped changes. Run proportionate validation.
Start with an ordinary shell or file tool and keep the final few turns for the required JSON
result. Do not spend the task budget narrating a plan, discovering plugins, or printing logs.
A response without recorded task-tool activity is invalid, even if its JSON is well formed.

You are the final execution worker for this task, not a planner. Do not delegate or invoke
deepseek-worker, opencode, codex exec, spawn_agent, followup_task, or any other agent runner.
Use only ordinary task-scoped file and shell tools allowed by the task.

Your final response must be exactly one JSON object with no Markdown fence or surrounding prose:
{{"status":"success","summary":"concise result","files_changed":[],"tests":[],"risks":[]}}
The only allowed status values are success, partial, blocked, or error. Keep summary concise. List
only files actually changed. The files_changed, tests, and risks fields must each be JSON arrays of
strings. Use [] when a list is empty; never use 0, null, or the string "none" for these fields. Put
test command outcomes in tests and unresolved concerns in risks.

Task:
{task}
"""


STATUS_ALIASES = {
    "success": "success",
    "succeeded": "success",
    "complete": "success",
    "completed": "success",
    "done": "success",
    "ok": "success",
    "partial": "partial",
    "incomplete": "partial",
    "blocked": "blocked",
    "error": "error",
    "failed": "error",
    "failure": "error",
}


def normalize_result(payload: Any) -> dict[str, Any] | None:
    if not isinstance(payload, dict) or set(payload) != {"status", "summary", "files_changed", "tests", "risks"}:
        return None
    status = payload.get("status")
    if not isinstance(status, str) or STATUS_ALIASES.get(status.strip().lower()) is None:
        return None
    if not isinstance(payload["summary"], str) or len(payload["summary"]) > 4000:
        return None
    normalized_lists: dict[str, list[str]] = {}
    for field in ("files_changed", "tests", "risks"):
        value = payload[field]
        if isinstance(value, list) and all(isinstance(item, str) for item in value):
            normalized_lists[field] = value
        elif field == "files_changed" and isinstance(value, int) and not isinstance(value, bool) and value == 0:
            normalized_lists[field] = []
        elif field in {"tests", "risks"} and isinstance(value, str) and value.strip().lower() == "none":
            normalized_lists[field] = []
        else:
            return None
    return {
        **payload,
        **normalized_lists,
        "status": STATUS_ALIASES[status.strip().lower()],
    }


def is_valid_result(payload: Any) -> bool:
    return normalize_result(payload) is not None


def parse_result_text(text: str) -> dict[str, Any] | None:
    """Extract the last valid result object from exact, fenced, or prose-wrapped JSON."""
    decoder = json.JSONDecoder()
    candidates: list[Any] = []
    stripped = text.strip()
    try:
        candidates.append(json.loads(stripped))
    except json.JSONDecodeError:
        for offset, char in enumerate(text):
            if char != "{":
                continue
            try:
                candidate, _end = decoder.raw_decode(text, offset)
            except json.JSONDecodeError:
                continue
            candidates.append(candidate)
    for candidate in reversed(candidates):
        normalized = normalize_result(candidate)
        if normalized is not None:
            return normalized
    return None


def parse_codex_events(stdout: str) -> tuple[dict[str, Any] | None, dict[str, int], bool]:
    message: dict[str, Any] | None = None
    usage: dict[str, int] = {}
    saw_agent_message = False
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "item.completed":
            item = event.get("item") or {}
            if item.get("type") == "agent_message":
                text = item.get("text")
                if isinstance(text, str):
                    saw_agent_message = True
                    parsed = parse_result_text(text)
                    if parsed is not None:
                        message = parsed
        elif event.get("type") == "turn.completed":
            raw_usage = event.get("usage") or {}
            usage = {key: int(value) for key, value in raw_usage.items() if isinstance(value, int)}
    return message, usage, saw_agent_message and message is None


def has_task_activity(stdout: str) -> bool:
    task_item_types = {"command_execution", "file_change", "mcp_tool_call", "web_search"}
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") not in {"item.started", "item.completed"}:
            continue
        item = event.get("item") or {}
        if item.get("type") in task_item_types:
            return True
    return False


def parse_opencode_events(stdout: str) -> tuple[dict[str, Any] | None, dict[str, int], bool, bool]:
    texts: list[str] = []
    usage = {
        "input_tokens": 0,
        "cached_input_tokens": 0,
        "cache_write_input_tokens": 0,
        "output_tokens": 0,
        "reasoning_output_tokens": 0,
    }
    task_activity = False
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        event_type = event.get("type")
        part = event.get("part") or {}
        if event_type == "text" and isinstance(part.get("text"), str):
            texts.append(part["text"])
        elif event_type == "tool_use":
            state = part.get("state") or {}
            if state.get("status") in {"completed", "running"}:
                task_activity = True
        elif event_type == "step_finish":
            tokens = part.get("tokens") or {}
            cache = tokens.get("cache") or {}
            usage["input_tokens"] += int(tokens.get("input") or 0)
            usage["cached_input_tokens"] += int(cache.get("read") or 0)
            usage["cache_write_input_tokens"] += int(cache.get("write") or 0)
            usage["output_tokens"] += int(tokens.get("output") or 0)
            usage["reasoning_output_tokens"] += int(tokens.get("reasoning") or 0)
    message = parse_result_text("\n".join(texts)) if texts else None
    return message, usage, bool(texts) and message is None, task_activity


def opencode_stream_diagnostics(stdout: str) -> dict[str, Any]:
    """Classify OpenCode's terminal stream without retaining model text or raw errors."""
    saw_opencode_event = False
    saw_step_finish = False
    saw_usable_text = False
    finish_reasons: list[str] = []
    saw_error_event = False
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        event_type = event.get("type")
        if event_type not in {"step_start", "step_finish", "tool_use", "text", "error"}:
            continue
        saw_opencode_event = True
        part = event.get("part") or {}
        if event_type == "text" and isinstance(part.get("text"), str) and part["text"].strip():
            saw_usable_text = True
        elif event_type == "step_finish":
            saw_step_finish = True
            reason = part.get("reason") or part.get("finishReason") or event.get("reason") or event.get("finishReason")
            if isinstance(reason, str) and reason.strip():
                finish_reasons.append(reason.strip().lower().replace("_", "-"))
        elif event_type == "error":
            saw_error_event = True

    failure: str | None = None
    last_reason = finish_reasons[-1] if finish_reasons else None
    if saw_opencode_event:
        if saw_error_event:
            failure = "OpenCode emitted an error event"
        elif not saw_step_finish:
            failure = "OpenCode stream ended without a step_finish event"
        elif last_reason is None:
            failure = "OpenCode step_finish did not include a reason"
        elif last_reason in {"length", "error", "unknown", "other"}:
            failure = f"OpenCode stream ended with finish reason {last_reason}"
        elif not saw_usable_text:
            failure = "OpenCode stream ended with zero usable text output"
    return {
        "is_opencode": saw_opencode_event,
        "saw_step_finish": saw_step_finish,
        "finish_reason": last_reason,
        "has_usable_text": saw_usable_text,
        "failure": failure,
    }


def parse_worker_events(stdout: str) -> tuple[dict[str, Any] | None, dict[str, int], bool, bool]:
    for line in stdout.splitlines():
        try:
            event_type = json.loads(line).get("type")
        except (json.JSONDecodeError, AttributeError):
            continue
        if event_type in {"step_start", "step_finish", "tool_use", "text"}:
            return parse_opencode_events(stdout)
    message, usage, invalid = parse_codex_events(stdout)
    return message, usage, invalid, has_task_activity(stdout)


def native_result_contract(stdout: str) -> tuple[dict[str, Any] | None, bool]:
    """Return the parent-visible final native-agent contract and invalid-message flag."""
    result, _usage, invalid_result = parse_codex_events(stdout)
    return result, invalid_result


def desktop_codex_binary() -> Path:
    if DESKTOP_CODEX_PATH.is_file() and os.access(DESKTOP_CODEX_PATH, os.X_OK):
        return DESKTOP_CODEX_PATH
    fallback = shutil.which("codex")
    if fallback:
        return Path(fallback).resolve()
    raise WorkerError("Codex Desktop binary not found")


def file_fingerprint(path: Path) -> dict[str, Any]:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    stat = path.stat()
    return {"size": stat.st_size, "mtime_ns": stat.st_mtime_ns, "sha256": digest.hexdigest()}


def state_db_snapshot() -> dict[str, dict[str, Any]]:
    return {str(path): file_fingerprint(path) for path in sorted(CODEX_HOME.glob("state_*.sqlite")) if path.is_file()}


def write_native_canary_config(source: Path, destination: Path, agent_provider: str) -> None:
    """Write only the parent and child Provider settings needed by the isolated Desktop canary."""
    try:
        config_text = source.read_text(encoding="utf-8")
        config = tomllib.loads(config_text)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise WorkerError(f"cannot read native canary config: {type(exc).__name__}") from exc
    providers = config.get("model_providers") or {}
    parent_provider = providers.get("openai-chatgpt") or {}
    child_provider = providers.get(agent_provider) or {}
    parent_required = ("name", "base_url", "wire_api", "requires_openai_auth", "experimental_bearer_token")
    child_required = ("name", "base_url", "wire_api")
    if not all(key in parent_provider for key in parent_required):
        raise WorkerError("native canary requires complete openai-chatgpt Provider settings")
    if not all(key in child_provider for key in child_required):
        raise WorkerError(f"native canary requires complete {agent_provider} Provider settings")
    rendered = [
        'model_provider = "openai-chatgpt"\n',
        "\n",
        "[agents]\n",
        "enabled = true\n",
        "\n",
        "[model_providers.openai-chatgpt]\n",
    ]
    for key in parent_required:
        value = parent_provider[key]
        if not isinstance(value, (bool, str)):
            raise WorkerError(f"unsupported native canary Provider value: {key}")
        rendered.append(f"{key} = {'true' if value else 'false'}\n" if isinstance(value, bool) else f"{key} = {json.dumps(value, ensure_ascii=False)}\n")
    rendered.extend(["\n", f"[model_providers.{agent_provider}]\n"])
    for key in child_required:
        value = child_provider[key]
        if not isinstance(value, (bool, str)):
            raise WorkerError(f"unsupported native canary Provider value: {key}")
        rendered.append(f"{key} = {'true' if value else 'false'}\n" if isinstance(value, bool) else f"{key} = {json.dumps(value, ensure_ascii=False)}\n")
    filtered_text = "".join(rendered)
    try:
        tomllib.loads(filtered_text)
    except tomllib.TOMLDecodeError as exc:
        raise WorkerError("native canary config became invalid after compatibility filtering") from exc
    destination.write_text(filtered_text, encoding="utf-8")
    os.chmod(destination, 0o600)


def build_v1_canary_catalog(source: Path, output: Path, parent_model: str) -> None:
    try:
        payload = json.loads(source.read_text(encoding="utf-8"))
        models = payload["models"]
    except (OSError, json.JSONDecodeError, KeyError, TypeError) as exc:
        raise WorkerError("cannot read the configured Codex model catalog") from exc
    if not isinstance(models, list):
        raise WorkerError("configured Codex model catalog has an unsupported shape")
    parent_found = deepseek_found = False
    rendered_models: list[dict[str, Any]] = []
    for raw_model in models:
        if not isinstance(raw_model, dict):
            continue
        model = copy.deepcopy(raw_model)
        if model.get("slug") == parent_model:
            model["multi_agent_version"] = "v1"
            parent_found = True
        if model.get("slug") == "deepseek-v4-flash":
            deepseek_found = True
        rendered_models.append(model)
    if not parent_found:
        raise WorkerError(f"parent model not found in configured catalog: {parent_model}")
    if not deepseek_found:
        raise WorkerError("deepseek-v4-flash not found in configured catalog")
    payload["models"] = rendered_models
    output.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(output, 0o600)


def build_cliproxy_canary_catalog(source: Path, output: Path, parent_model: str) -> None:
    try:
        payload = json.loads(source.read_text(encoding="utf-8"))
        models = payload["models"]
    except (OSError, json.JSONDecodeError, KeyError, TypeError) as exc:
        raise WorkerError("cannot read the configured Codex model catalog") from exc
    if not isinstance(models, list):
        raise WorkerError("configured Codex model catalog has an unsupported shape")
    parent_found = alias_found = False
    for raw_model in models:
        if not isinstance(raw_model, dict):
            continue
        if raw_model.get("slug") == parent_model:
            raw_model["multi_agent_version"] = "v2"
            parent_found = True
        if raw_model.get("slug") == CLIPROXY_ALIAS:
            raw_model["multi_agent_version"] = "v2"
            raw_model["use_responses_lite"] = False
            raw_model.pop("tool_mode", None)
            alias_found = True
    if not parent_found:
        raise WorkerError(f"parent model not found in configured catalog: {parent_model}")
    if not alias_found:
        raise WorkerError(f"CLIProxyAPI alias not found in configured catalog: {CLIPROXY_ALIAS}")
    output.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(output, 0o600)


def native_v1_child_result(stdout: str, nonce: str) -> tuple[dict[str, Any] | None, str | None, bool, bool, bool]:
    spawned = waited = False
    child_result: dict[str, Any] | None = None
    child_ids: list[str] = []
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") != "item.completed":
            continue
        item = event.get("item") or {}
        if item.get("type") != "collab_tool_call":
            continue
        if item.get("tool") == "spawn_agent":
            child_ids.extend(str(value) for value in (item.get("receiver_thread_ids") or []))
            spawned = len(child_ids) == 1 and item.get("status") == "completed"
            continue
        if item.get("tool") != "wait":
            continue
        waited = item.get("status") == "completed"
        states = item.get("agents_states") or {}
        if isinstance(states, dict):
            child_ids.extend(str(value) for value in states if str(value) not in child_ids)
        candidates = states.values() if isinstance(states, dict) else states if isinstance(states, list) else []
        for state in candidates:
            if not isinstance(state, dict):
                continue
            message = state.get("message")
            if isinstance(message, dict):
                parsed = message
            elif isinstance(message, str):
                try:
                    parsed = json.loads(message)
                except json.JSONDecodeError:
                    continue
            else:
                continue
            if is_valid_result(parsed):
                child_result = parsed
    expected_summaries = {f"native-v1-canary:{nonce}", f"cliproxy-native-canary:{nonce}"}
    nonce_verified = bool(child_result and child_result.get("summary") in expected_summaries)
    child_id = child_ids[0] if len(child_ids) == 1 else None
    spawned = spawned or bool(waited and child_id)
    return child_result, child_id, spawned, waited, nonce_verified


def native_event_diagnostics(stdout: str) -> dict[str, Any]:
    item_types: set[str] = set()
    collab_tools: set[str] = set()
    parent_message = ""
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        item = event.get("item") or {}
        item_type = item.get("type")
        if isinstance(item_type, str):
            item_types.add(item_type)
        if item_type == "collab_tool_call" and isinstance(item.get("tool"), str):
            collab_tools.add(item["tool"])
        if item_type == "agent_message" and isinstance(item.get("text"), str):
            parent_message = redact(item["text"], 300)
    return {
        "item_types": sorted(item_types),
        "collab_tools": sorted(collab_tools),
        "parent_message": parent_message,
    }


def child_rollout_evidence(
    codex_home: Path,
    child_id: str | None,
    nonce: str,
    rollout_path: Path | None = None,
    expected_summary: str | None = None,
    expected_outputs: tuple[str, ...] = (),
) -> dict[str, Any]:
    evidence = {
        "rollout_found": False,
        "task_payload_present": False,
        "tool_calls": [],
        "tool_outputs": 0,
        "expected_outputs_verified": False,
        "parallel_tool_calls_observed": False,
        "final_result": None,
        "final_result_valid": False,
        "final_result_nonce_verified": False,
    }
    if not child_id and rollout_path is None:
        return evidence
    rollout = rollout_path
    if rollout is None:
        for candidate in codex_home.rglob("rollout-*.jsonl"):
            if child_id and child_id in candidate.name:
                rollout = candidate
                break
    if rollout is None:
        return evidence
    try:
        rollout.resolve().relative_to(codex_home.resolve())
    except (OSError, ValueError):
        return evidence
    evidence["rollout_found"] = True
    consecutive_calls = 0
    max_consecutive_calls = 0
    tool_calls: list[str] = []
    final_result: dict[str, Any] | None = None
    observed_outputs: list[str] = []
    try:
        lines = rollout.read_text(encoding="utf-8").splitlines()
    except OSError:
        return evidence
    for line in lines:
        if nonce in line:
            evidence["task_payload_present"] = True
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        payload = event.get("payload") or {}
        if event.get("type") != "response_item" or not isinstance(payload, dict):
            continue
        item_type = payload.get("type")
        if item_type == "function_call":
            name = str(payload.get("name") or "")
            if name:
                tool_calls.append(name)
            consecutive_calls += 1
            max_consecutive_calls = max(max_consecutive_calls, consecutive_calls)
        elif item_type == "function_call_output":
            evidence["tool_outputs"] += 1
            output = payload.get("output")
            if isinstance(output, str):
                observed_outputs.append(output)
            consecutive_calls = 0
        elif item_type == "message" and payload.get("role") == "assistant":
            content = payload.get("content") or []
            text = "\n".join(
                str(part.get("text"))
                for part in content
                if isinstance(part, dict) and part.get("type") == "output_text" and isinstance(part.get("text"), str)
            )
            parsed = parse_result_text(text)
            if parsed is not None:
                final_result = parsed
        elif item_type not in {"reasoning", "message"}:
            consecutive_calls = 0
    evidence["tool_calls"] = tool_calls
    evidence["expected_outputs_verified"] = bool(expected_outputs) and all(
        any(expected in output for output in observed_outputs) for expected in expected_outputs
    )
    evidence["parallel_tool_calls_observed"] = max_consecutive_calls >= 2
    evidence["final_result"] = final_result
    evidence["final_result_valid"] = final_result is not None
    expected_summary = expected_summary or f"cliproxy-native-canary:{nonce}"
    evidence["final_result_nonce_verified"] = bool(final_result and final_result.get("summary") == expected_summary)
    return evidence


def find_isolated_native_child(
    codex_home: Path,
    provider: str,
    model: str,
    agent_role: str,
    created_after_ms: int,
    nonce: str,
) -> dict[str, Any]:
    """Resolve one V2 child from isolated state when JSON events omit its thread id."""
    matches: list[dict[str, Any]] = []
    for state_db in sorted(codex_home.glob("state_*.sqlite"), key=lambda path: path.stat().st_mtime_ns, reverse=True):
        connection: sqlite3.Connection | None = None
        try:
            connection = sqlite3.connect(f"{state_db.resolve().as_uri()}?mode=ro", uri=True, timeout=0.1)
            columns = {row[1] for row in connection.execute("PRAGMA table_info(threads)")}
            required = {"id", "rollout_path", "model_provider", "model", "agent_role", "created_at", "created_at_ms"}
            if not required.issubset(columns):
                continue
            rows = connection.execute(
                """SELECT id, rollout_path, model_provider, model, reasoning_effort, agent_role,
                          COALESCE(created_at_ms, created_at * 1000)
                   FROM threads
                   WHERE model_provider = ? AND model = ? AND lower(agent_role) = lower(?)
                     AND COALESCE(created_at_ms, created_at * 1000) >= ?""",
                (provider, model, agent_role, created_after_ms),
            ).fetchall()
            for row in rows:
                rollout = Path(str(row[1]))
                try:
                    rollout.resolve().relative_to(codex_home.resolve())
                    contains_nonce = rollout.is_file() and nonce in rollout.read_text(encoding="utf-8")
                except (OSError, ValueError, UnicodeError):
                    contains_nonce = False
                if contains_nonce:
                    matches.append(
                        {
                            "id": str(row[0]),
                            "rollout_path": rollout,
                            "model_provider": row[2],
                            "model": row[3],
                            "reasoning_effort": row[4],
                            "agent_role": row[5],
                            "created_at_ms": row[6],
                        }
                    )
        except (OSError, sqlite3.Error):
            continue
        finally:
            if connection is not None:
                connection.close()
    unique_matches = {match["id"]: match for match in matches}
    if len(unique_matches) != 1:
        return {"child": None, "candidate_count": len(unique_matches)}
    return {"child": next(iter(unique_matches.values())), "candidate_count": 1}


def bridge_provider_completed(path: Path, offset: int, provider: str) -> bool:
    if not path.is_file() or path.stat().st_size < offset:
        return False
    marker = f"completed backend={provider}".encode()
    with path.open("rb") as handle:
        handle.seek(offset)
        return any(marker in line for line in handle)


def native_child_metadata(codex_home: Path, child_id: str | None) -> dict[str, Any] | None:
    if not child_id:
        return None
    for state_db in sorted(codex_home.glob("state_*.sqlite"), key=lambda path: path.stat().st_mtime_ns, reverse=True):
        connection: sqlite3.Connection | None = None
        try:
            connection = sqlite3.connect(f"{state_db.resolve().as_uri()}?mode=ro", uri=True, timeout=0.1)
            columns = {row[1] for row in connection.execute("PRAGMA table_info(threads)")}
            required = {"id", "model_provider", "model", "reasoning_effort", "agent_role"}
            if not required.issubset(columns):
                continue
            row = connection.execute(
                "SELECT model_provider, model, reasoning_effort, agent_role FROM threads WHERE id = ?",
                (child_id,),
            ).fetchone()
            if row:
                return {
                    "model_provider": row[0],
                    "model": row[1],
                    "reasoning_effort": row[2],
                    "agent_role": row[3],
                }
        except (OSError, sqlite3.Error):
            continue
        finally:
            if connection is not None:
                connection.close()
    return None


