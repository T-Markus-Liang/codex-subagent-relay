def _circuit_lock():
    CIRCUIT_LOCK_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = CIRCUIT_LOCK_PATH.open("a+", encoding="utf-8")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def _read_circuit_state() -> dict[str, dict[str, Any]]:
    try:
        raw = json.loads(CIRCUIT_STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, TypeError):
        return {}
    if not isinstance(raw, dict):
        return {}
    state: dict[str, dict[str, Any]] = {}
    for provider, item in raw.items():
        if provider not in PROVIDERS or not isinstance(item, dict):
            continue
        try:
            failures = max(0, int(item.get("failures", 0)))
            tripped_until = max(0.0, float(item.get("tripped_until", 0.0)))
        except (TypeError, ValueError):
            continue
        state[provider] = {"failures": failures, "tripped_until": tripped_until}
    return state


def _write_circuit_state(state: dict[str, dict[str, Any]]) -> bool:
    temporary: Path | None = None
    try:
        CIRCUIT_STATE_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=CIRCUIT_STATE_PATH.parent, prefix=".worker-circuit-", delete=False) as handle:
            json.dump(state, handle, separators=(",", ":"))
            handle.write("\n")
            temporary = Path(handle.name)
        os.chmod(temporary, 0o600)
        os.replace(temporary, CIRCUIT_STATE_PATH)
        return True
    except OSError:
        if temporary is not None:
            try:
                temporary.unlink(missing_ok=True)
            except OSError:
                pass
        return False


def _with_circuit_state(update) -> dict[str, dict[str, Any]]:
    """Read/update circuit state; any persistence failure is deliberately fail-open."""
    try:
        handle = _circuit_lock()
    except OSError:
        return {}
    try:
        state = _read_circuit_state()
        update(state)
        return state if _write_circuit_state(state) else None
    finally:
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        handle.close()


def circuit_open(provider: str) -> bool:
    now = time.time()
    result = {"open": False}

    def update(state: dict[str, dict[str, Any]]) -> None:
        item = state.get(provider)
        if item and item["tripped_until"] > now:
            result["open"] = True
        elif item:
            state.pop(provider, None)

    persisted = _with_circuit_state(update)
    if persisted is None:
        return False
    return bool(result["open"])


def circuit_failure(provider: str) -> None:
    now = time.time()

    def update(state: dict[str, dict[str, Any]]) -> None:
        item = state.setdefault(provider, {"failures": 0, "tripped_until": 0.0})
        item["failures"] += 1
        if item["failures"] >= CIRCUIT_FAILURE_THRESHOLD:
            item["tripped_until"] = now + CIRCUIT_TTL_SECONDS

    _with_circuit_state(update)


def circuit_success(provider: str) -> None:
    _with_circuit_state(lambda state: state.pop(provider, None))


def circuit_summary() -> dict[str, dict[str, Any]]:
    now = time.time()
    result: dict[str, dict[str, Any]] = {}

    def update(state: dict[str, dict[str, Any]]) -> None:
        for provider, item in list(state.items()):
            if item["tripped_until"] <= now:
                state.pop(provider, None)
                continue
            result[provider] = {
                "failures": item["failures"],
                "remaining_seconds": round(item["tripped_until"] - now, 1),
            }

    _with_circuit_state(update)
    return result


def circuit_reset() -> None:
    def update(state: dict[str, dict[str, Any]]) -> None:
        state.clear()

    _with_circuit_state(update)


