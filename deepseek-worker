    write_json(metadata_path, metadata)
    return metadata


def idempotency_digest(key: str | None) -> str | None:
    if key is None:
        return None
    if not key.strip() or len(key.encode("utf-8")) > 256:
        raise WorkerError("idempotency key must contain 1-256 bytes")
    return hashlib.sha256(key.encode("utf-8")).hexdigest()


def find_idempotent_job(key_digest: str, workdir: Path) -> dict[str, Any] | None:
    """Return a prior job for the same opaque key and workdir without persisting key text."""
    records, _invalid = job_store().modern_metadata()
    for metadata in records:
        if (
            isinstance(metadata, dict)
            and metadata.get("idempotency_key_sha256") == key_digest
            and metadata.get("workdir") == str(workdir)
        ):
            return metadata
    return None


def idempotency_lock(key_digest: str):
    """Serialize duplicate launch claims without retaining the caller's opaque key."""
    lock_path = JOB_ROOT / "idempotency" / f"{key_digest}.lock"
    lock_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = lock_path.open("a+", encoding="utf-8")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def write_json(path: Path, payload: dict[str, Any]) -> None:
    job_store().write_json(path, payload)


def append_job_event(job_id: str, event: str, state: str, **details: Any) -> None:
    """Persist lifecycle facts only; prompts, raw events, and request payloads never enter this log."""
    if state not in JOB_STATES:
        raise WorkerError("invalid job event state")
    safe_details = {
        key: value for key, value in details.items()
        if key in {"reason", "process_terminated", "signal"} and isinstance(value, (str, bool))
    }
    record = {
        "timestamp": datetime.now(UTC).isoformat(),
        "event": event,
        "state": state,
        **safe_details,
    }
    path = job_artifact_path(job_id, "events.jsonl")
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(fd, (json.dumps(record, separators=(",", ":")) + "\n").encode("utf-8"))
    finally:
        os.close(fd)


def write_job_result(job_id: str, payload: dict[str, Any], state: str, diagnostic: str | None = None) -> dict[str, Any]:
    if state not in TERMINAL_JOB_STATES:
        raise WorkerError("invalid terminal job state")
    metadata = read_job_metadata(job_id)
    if metadata.get("state") in TERMINAL_JOB_STATES:
        return metadata
    _metadata_path, stdout_path, stderr_path = job_paths(job_id)
    after = workspace_snapshot(Path(str(metadata["workdir"])))
    write_json(job_artifact_path(job_id, "after.json"), after)
    write_json(job_artifact_path(job_id, "result.json"), payload)
    if diagnostic:
        write_json(job_artifact_path(job_id, "diagnostic.json"), {"message": redact(diagnostic, 1000)})
    update_job_metadata(
        job_id,
        state=state,
        finished_at=datetime.now(UTC).isoformat(),
        result_status=payload.get("status"),
        result_path="result.json",
        after_manifest_path="after.json",
        diagnostic_path="diagnostic.json" if diagnostic else None,
    )
    append_job_event(job_id, "terminal", state, reason=str(payload.get("status", "error")))
    # The result is durable; discard raw streamed model output after terminalization.
    for path in (stdout_path, stderr_path):
        try:
            path.unlink(missing_ok=True)
        except OSError:
            pass
    return read_job_metadata(job_id)


def launch_worker(args: argparse.Namespace) -> dict[str, Any]:
    key_digest = idempotency_digest(getattr(args, "idempotency_key", None))
    if key_digest is None:
        return _launch_worker(args)
    handle = idempotency_lock(key_digest)
    try:
        return _launch_worker(args)
    finally:
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        handle.close()


def _launch_worker(args: argparse.Namespace) -> dict[str, Any]:
    """Start a run in a separate process group and return immediately for Desktop polling."""
    task = load_task(args.task, args.task_file)
    workdir = Path(args.workdir).expanduser().resolve()
    if not workdir.is_dir():
        raise WorkerError(f"workdir not found: {workdir}")
    key_digest = idempotency_digest(getattr(args, "idempotency_key", None))
    if key_digest:
        existing = find_idempotent_job(key_digest, workdir)
        if existing:
            return {
                "status": "running" if existing.get("state") not in TERMINAL_JOB_STATES else str(existing.get("result_status", "error")),
                "job_id": existing["job_id"],
                "role": existing.get("role"),
                "provider": existing.get("provider"),
                "job_state": existing.get("state"),
                "idempotent_reuse": True,
            }
    job_id = f"{int(time.time())}-{secrets.token_hex(6)}"
    metadata_path, stdout_path, stderr_path = job_paths(job_id)
    telemetry_scope = getattr(args, "telemetry_scope", "production")
    command = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--json",
        "run",
        "--role",
        args.role,
        "--workdir",
        str(workdir),
        "--provider",
        args.provider,
        "--sandbox",
        args.sandbox,
        "--timeout",
        str(args.timeout),
        "--telemetry-scope",
        telemetry_scope,
    ]
    if args.task_file:
        command.extend(("--task-file", str(Path(args.task_file).expanduser().resolve())))
    else:
        command.extend(("--task", args.task))
    if args.no_record:
        command.append("--no-record")
    JOB_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_json(job_artifact_path(job_id, "before.json"), workspace_snapshot(workdir))
    write_json(
        metadata_path,
        {
            "schema_version": JOB_SCHEMA_VERSION,
            "job_id": job_id,
            "state": "queued",
            "created_at": datetime.now(UTC).isoformat(),
            "role": args.role,
            "provider": args.provider,
            "sandbox": args.sandbox,
            "timeout_seconds": args.timeout,
            "workdir": str(workdir),
            "task_sha256": hashlib.sha256(task.encode("utf-8")).hexdigest(),
            "idempotency_key_sha256": key_digest,
            "before_manifest_path": "before.json",
        },
    )
    append_job_event(job_id, "created", "queued")
    with stdout_path.open("w", encoding="utf-8") as stdout, stderr_path.open("w", encoding="utf-8") as stderr:
        os.chmod(stdout_path, 0o600)
        os.chmod(stderr_path, 0o600)
        process = subprocess.Popen(
            command,
            cwd=workdir,
            text=True,
            stdin=subprocess.DEVNULL,
            stdout=stdout,
            stderr=stderr,
            start_new_session=True,
            env={**os.environ, "DEEPSEEK_WORKER_LAUNCHED": "1", "DEEPSEEK_WORKER_JOB_ID": job_id},
        )
    update_job_metadata(job_id, state="running", pid=process.pid, started_at=datetime.now(UTC).isoformat())
    append_job_event(job_id, "started", "running")
    return {"status": "running", "job_id": job_id, "role": args.role, "provider": args.provider, "job_state": "running"}


def process_is_running(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def job_result_response(job_id: str, metadata: dict[str, Any]) -> dict[str, Any]:
    try:
        result = json.loads(job_artifact_path(job_id, "result.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        result = None
    if isinstance(result, dict):
        return {**result, "job_id": job_id, "job_state": metadata.get("state")}
    return {
        "status": "error",
        "job_id": job_id,
        "job_state": metadata.get("state"),
        "summary": "Worker terminal state is missing its structured result artifact.",
        "files_changed": [],
        "tests": [],
        "risks": ["job artifact integrity failure"],
    }


def job_deadline_expired(metadata: dict[str, Any]) -> bool:
    timeout_seconds = int(metadata.get("timeout_seconds") or 0)
    if timeout_seconds <= 0:
        role = str(metadata.get("role", "general-execution"))
        timeout_seconds = effective_timeout(0, role)
    try:
        started_at = datetime.fromisoformat(str(metadata["started_at"]))
    except (KeyError, TypeError, ValueError):
        return False
    return datetime.now(UTC) > started_at + timedelta(seconds=timeout_seconds + JOB_TIMEOUT_GRACE_SECONDS)


def terminate_process_group(pid: int) -> bool:
    if not process_is_running(pid):
        return False
    try:
        os.killpg(pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError, OSError):
        return False
    deadline = time.monotonic() + 2.0
    while process_is_running(pid) and time.monotonic() < deadline:
        time.sleep(0.05)
    if process_is_running(pid):
        try:
            os.killpg(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError, OSError):
            return False
    return True


def terminate_job_processes(metadata: dict[str, Any]) -> bool:
    pids = [int(metadata.get("pid", 0)), int(metadata.get("active_provider_pid", 0) or 0)]
    terminated = False
    for pid in dict.fromkeys(pid for pid in pids if pid > 0):
        terminated = terminate_process_group(pid) or terminated
    return terminated


def terminal_job_payload(metadata: dict[str, Any], status: str, summary: str, risk: str) -> dict[str, Any]:
    job_id = str(metadata["job_id"])
    try:
        before = json.loads(job_artifact_path(job_id, "before.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        before = {}
    return {
        "status": status,
        "provider": metadata.get("provider"),
        "role": metadata.get("role"),
        "summary": summary,
        "files_changed": changed_workspace_paths(before, workspace_snapshot(Path(str(metadata["workdir"]))),),
        "tests": [],
        "risks": [risk],
    }


def terminal_state_for_payload(payload: dict[str, Any], default_state: str) -> str:
    """Any unaccepted terminal outcome with side effects is an explicit review handoff."""
    if default_state in {"failed", "cancelled", "timed_out"} and payload.get("files_changed"):
        return "partial"
    return default_state


def poll_worker(job_id: str) -> dict[str, Any]:
    metadata = read_job_metadata(job_id)
    if metadata.get("state") in TERMINAL_JOB_STATES:
        return job_result_response(job_id, metadata)
    _metadata_path, stdout_path, stderr_path = job_paths(job_id)
    pid = int(metadata.get("pid", 0))
    if job_deadline_expired(metadata):
        terminated = terminate_job_processes(metadata)
        append_job_event(job_id, "deadline_expired", str(metadata.get("state", "running")), process_terminated=terminated, signal="TERM/KILL")
        payload = terminal_job_payload(metadata, "error", "DeepSeek worker exceeded its bounded job deadline.", "job timed out; no automatic replay was performed")
        write_job_result(job_id, payload, terminal_state_for_payload(payload, "timed_out"))
        return job_result_response(job_id, read_job_metadata(job_id))
    try:
        raw = stdout_path.read_text(encoding="utf-8").strip()
        result = json.loads(raw) if raw else None
    except (OSError, json.JSONDecodeError):
        result = None
    if isinstance(result, dict):
        state = job_state_for_payload(result)
        write_job_result(job_id, result, state)
        return job_result_response(job_id, read_job_metadata(job_id))
    if process_is_running(pid):
        if metadata.get("state") != "running":
            update_job_metadata(job_id, state="running")
        return {"status": "running", "job_id": job_id, "job_state": "running"}
    try:
        error = redact(stderr_path.read_text(encoding="utf-8"), 300)
    except OSError:
        error = "worker exited without result"
    payload = terminal_job_payload(metadata, "error", "DeepSeek worker exited without a structured result.", error or "stale worker PID exited without result")
    write_job_result(job_id, payload, terminal_state_for_payload(payload, "failed"), error)
    return job_result_response(job_id, read_job_metadata(job_id))


def cancel_worker(job_id: str) -> dict[str, Any]:
    metadata = read_job_metadata(job_id)
    if metadata.get("state") in TERMINAL_JOB_STATES:
        return job_result_response(job_id, metadata)
    pid = int(metadata.get("pid", 0))
    terminated = terminate_job_processes(metadata)
    append_job_event(job_id, "cancel_requested", str(metadata.get("state", "running")), process_terminated=terminated, signal="TERM/KILL")
    changed_files = terminal_job_payload(metadata, "blocked", "", "")["files_changed"]
    payload = terminal_job_payload(
        metadata,
        "blocked",
        "DeepSeek worker was cancelled before a structured result was accepted.",
        "cancellation requested; existing workspace changes require main-model review" if changed_files else "cancellation requested before workspace changes",
    )
    write_job_result(job_id, payload, terminal_state_for_payload(payload, "cancelled"))
    return {**job_result_response(job_id, read_job_metadata(job_id)), "process_terminated": terminated}


def job_public_metadata(metadata: dict[str, Any]) -> dict[str, Any]:
    """Expose durable lifecycle facts without task text, raw output, or opaque key material."""
    fields = (
        "job_id", "schema_version", "state", "created_at", "started_at", "finished_at",
        "role", "provider", "sandbox", "timeout_seconds", "result_status",
        "before_manifest_path", "after_manifest_path", "result_path", "diagnostic_path",
    )
    return {field: metadata[field] for field in fields if field in metadata}


def legacy_job_public_metadata(record: dict[str, Any]) -> dict[str, Any]:
    """Expose only safe legacy facts; flat artifacts cannot be polled or resumed."""
    metadata = record["metadata"]
    return {
        "job_id": record["job_id"],
        "schema_version": 0,
        "state": "legacy",
        "created_at": metadata.get("started_at"),
        "role": metadata.get("role") if isinstance(metadata.get("role"), str) else None,
        "provider": metadata.get("provider") if isinstance(metadata.get("provider"), str) else None,
        "legacy_action": "archive-only",
    }


def list_jobs(limit: int = 20) -> dict[str, Any]:
    if not 1 <= limit <= 100:
        raise WorkerError("job list limit must be between 1 and 100")
    modern, invalid_modern = job_store().modern_metadata()
    legacy, invalid_legacy = job_store().legacy_metadata()
    jobs = [job_public_metadata(metadata) for metadata in modern]
    jobs.extend(legacy_job_public_metadata(record) for record in legacy)
    jobs.sort(key=lambda item: str(item.get("created_at", "")), reverse=True)
    return {
        "status": "success",
        "jobs": jobs[:limit],
        "legacy": {"count": len(legacy), "action": "archive-only", "invalid_artifacts": invalid_legacy},
        "invalid_modern_job_directories": invalid_modern,
    }


def inspect_job(job_id: str) -> dict[str, Any]:
    try:
        metadata = read_job_metadata(job_id)
    except WorkerError:
        legacy, _invalid = job_store().legacy_metadata()
        record = next((item for item in legacy if item["job_id"] == job_id), None)
        if record is None:
            raise
        return {
            "status": "success",
            "job": legacy_job_public_metadata(record),
            "legacy_note": "This pre-runtime artifact is read-only and cannot be polled, cancelled, or resumed.",
        }
    payload: dict[str, Any] = {"status": "success", "job": job_public_metadata(metadata)}
    for artifact in ("before.json", "after.json", "result.json", "diagnostic.json"):
        try:
            value = json.loads(job_artifact_path(job_id, artifact).read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        payload[artifact.removesuffix(".json")] = value
    try:
        payload["events"] = [
            item for line in job_artifact_path(job_id, "events.jsonl").read_text(encoding="utf-8").splitlines()
            if isinstance((item := json.loads(line)), dict)
        ]
    except (OSError, json.JSONDecodeError):
        pass
    return payload


def terminal_job_finished_at(metadata: dict[str, Any]) -> datetime | None:
    """Return a terminal timestamp only for a well-formed, finished job."""
    if metadata.get("state") not in TERMINAL_JOB_STATES:
        return None
    try:
        value = datetime.fromisoformat(str(metadata["finished_at"]).replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError):
        return None
    return value if value.tzinfo is not None else value.replace(tzinfo=UTC)


def cleanup_terminal_jobs(retention_hours: float, apply: bool = False, legacy_action: str = "report") -> dict[str, Any]:
    """Preview or remove expired modern jobs; legacy files need an explicit archive action."""
    if not 0 <= retention_hours <= MAX_TERMINAL_JOB_RETENTION_HOURS:
        raise WorkerError(f"retention hours must be between 0 and {MAX_TERMINAL_JOB_RETENTION_HOURS}")
    if legacy_action not in {"report", "archive"}:
        raise WorkerError("legacy action must be report or archive")
    cutoff = datetime.now(UTC) - timedelta(hours=retention_hours)
    candidates: list[str] = []
    skipped = {"active": 0, "invalid": 0, "recent": 0, "legacy": 0}
    modern, invalid_modern = job_store().modern_metadata()
    legacy, invalid_legacy = job_store().legacy_metadata()
    skipped["invalid"] = invalid_modern + invalid_legacy
    skipped["legacy"] = len(legacy)
    for metadata in modern:
        finished_at = terminal_job_finished_at(metadata)
        if finished_at is None:
            skipped["active"] += 1
            continue
        if finished_at > cutoff:
            skipped["recent"] += 1
            continue
        candidates.append(str(metadata["job_id"]))
    removed: list[str] = []
    if apply:
        for job_id in candidates:
            directory = JOB_ROOT / job_id
            # Recheck before removal so a concurrent transition is never deleted.
            try:
                metadata = json.loads((directory / "meta.json").read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                skipped["invalid"] += 1
                continue
            finished_at = terminal_job_finished_at(metadata) if isinstance(metadata, dict) and metadata.get("job_id") == job_id else None
            if finished_at is None or finished_at > cutoff:
                skipped["active"] += 1
                continue
            try:
                shutil.rmtree(directory)
                removed.append(job_id)
            except OSError:
                skipped["invalid"] += 1
    archived_legacy_job_ids: list[str] = []
    if legacy_action == "archive" and apply:
        for record in legacy:
            metadata = record["metadata"]
            pid = metadata.get("pid")
            if isinstance(pid, int) and process_is_running(pid):
                skipped["active"] += 1
                continue
            try:
                job_store().archive_legacy(record)
                archived_legacy_job_ids.append(record["job_id"])
            except (OSError, ValueError):
                skipped["invalid"] += 1
    return {
        "status": "success",
        "retention_hours": retention_hours,
        "dry_run": not apply,
        "candidate_job_ids": candidates,
        "removed_job_ids": removed,
        "legacy": {
            "action": legacy_action,
            "dry_run": not apply,
            "candidate_job_ids": [record["job_id"] for record in legacy] if legacy_action == "archive" else [],
            "archived_job_ids": archived_legacy_job_ids,
        },
        "skipped": skipped,
    }


def run_worker(args: argparse.Namespace) -> dict[str, Any]:
    task = load_task(args.task, args.task_file)
    decision = route(args.role, task)
    if decision["target"] != "deepseek":
        return {
            "status": "routed_to_main",
            "target": decision["target"],
            "role": decision["role"],
            "reason": decision["reason"],
            "summary": "Task intentionally retained by the configured main-model route.",
            "files_changed": [],
            "tests": [],
            "risks": [],
        }

    workdir = Path(args.workdir).expanduser().resolve()
    if not workdir.is_dir():
        raise WorkerError(f"workdir not found: {workdir}")
    selected_provider = args.provider if args.provider != "auto" else decision["provider"]
    if selected_provider not in PROVIDERS:
        raise WorkerError(f"unknown provider: {selected_provider}")
    automatic = args.provider == "auto"
    provider_order = build_provider_order(decision["role"], selected_provider, automatic)
    if automatic:
        provider_order = [provider for provider in provider_order if not circuit_open(provider)]
        if not provider_order:
            payload = {
                "status": "error",
                "provider": selected_provider,
                "profile": PROVIDERS[selected_provider]["profile"],
                "role": decision["role"],
                "summary": "All automatic DeepSeek providers are temporarily circuit-open.",
                "files_changed": [],
                "tests": [],
                "risks": ["provider circuit state is fail-open when its state file cannot be read or written"],
                "usage": {},
                "duration_seconds": 0.0,
                "requested_provider": args.provider,
                "fallback_attempted": False,
            }
            if not args.no_record:
                record_run(payload, run_type="external_run", telemetry_scope=getattr(args, "telemetry_scope", "production"))
            return payload
    sandbox = args.sandbox if args.sandbox != "auto" else decision["sandbox"]
    lock_handle = None
    if sandbox == "workspace-write":
        try:
            lock_handle = workdir_lock(workdir)
        except WorkerError as exc:
            payload = {
                "status": "blocked",
                "provider": selected_provider,
                "profile": PROVIDERS[selected_provider]["profile"],
                "role": decision["role"],
                "summary": "A write worker is already active for this workdir.",
                "files_changed": [],
                "tests": [],
                "risks": [str(exc)],
                "usage": {},
                "duration_seconds": 0.0,
                "requested_provider": args.provider,
                "fallback_attempted": False,
            }
            if not args.no_record:
                record_run(payload, run_type="external_run", telemetry_scope=getattr(args, "telemetry_scope", "production"))
            return payload
    try:
        return _run_worker_locked(args, task, workdir, decision, selected_provider, provider_order, sandbox)
    finally:
        if lock_handle is not None:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
            lock_handle.close()


def _run_worker_locked(
    args: argparse.Namespace,
    task: str,
    workdir: Path,
    decision: dict[str, Any],
    selected_provider: str,
    provider_order: list[str],
    sandbox: str,
) -> dict[str, Any]:
    automatic = args.provider == "auto"
    before = workspace_snapshot(workdir)
    current_snapshot = before
    started = time.monotonic()
    total_timeout = effective_timeout(args.timeout, decision["role"])
    attempt_timeouts = provider_timeouts(total_timeout, len(provider_order))
    attempts: list[dict[str, str]] = []
    completed: subprocess.CompletedProcess[str] | None = None
    message: dict[str, Any] | None = None
    usage: dict[str, int] = {}
    total_usage: dict[str, int] = {}
    accepted_usage: dict[str, int] = {}
    side_effect_attempt: dict[str, Any] | None = None
    accepted = False
    used_stream_retry = False
    used_finalization_recovery = False
    last_stream = {"finish_reason": None, "failure": None}
    provider = selected_provider
    profile = PROVIDERS[provider]["profile"]
    provider_busy = False
    for attempt_index, provider in enumerate(provider_order):
        profile = PROVIDERS[provider]["profile"]
        try:
            lease_handle = provider_lease(provider)
        except WorkerError as exc:
            attempts.append({"provider": provider, "error": str(exc), "category": "provider_busy"})
            provider_busy = True
            if automatic:
                continue
            break
        try:
            command = adapter_command(provider, workdir, decision["role"], sandbox, task)
            provider_deadline = time.monotonic() + attempt_timeouts[attempt_index]
            stream_retry_count = 0
            while True:
                remaining_seconds = max(1, int(provider_deadline - time.monotonic()))
                try:
                    completed = invoke_codex(
                        command,
                        workdir,
                        remaining_seconds,
                        env={**os.environ, "OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX": "131072"},
                    )
                except FileNotFoundError as exc:
                    raise WorkerError("opencode command not found") from exc
                message, usage, invalid_result, task_activity = parse_worker_events(completed.stdout)
                stream = opencode_stream_diagnostics(completed.stdout)
                last_stream = stream
                attempt_snapshot = workspace_snapshot(workdir)
                attempt_changes = changed_workspace_paths(current_snapshot, attempt_snapshot)
                session_id = opencode_session_id(completed.stdout)
                recovered_finalization = False
                recovered_usage: dict[str, int] | None = None
                finalization_used_tools = False
                recovery_budget = finalization_timeout(int(provider_deadline - time.monotonic()))
                if (
                    completed.returncode == 0
                    and message is None
                    and task_activity
                    and not attempt_changes
                    and stream["failure"] is not None
                    and session_id is not None
                    and recovery_budget >= 5
                ):
                    try:
                        recovery = invoke_codex(
                            finalization_command(workdir, session_id, sandbox),
                            workdir,
                            recovery_budget,
                            env={**os.environ, "OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX": "131072"},
                        )
                    except FileNotFoundError as exc:
                        raise WorkerError("opencode command not found") from exc
                    recovered_message, recovered_usage, recovered_invalid, recovered_activity = parse_worker_events(recovery.stdout)
                    message = recovered_message
                    usage = combined_usage(usage, recovered_usage)
                    invalid_result = recovered_invalid
                    finalization_used_tools = recovered_activity
                    completed = recovery
                    stream = opencode_stream_diagnostics(recovery.stdout)
                    last_stream = stream
                    attempt_snapshot = workspace_snapshot(workdir)
                    attempt_changes = changed_workspace_paths(current_snapshot, attempt_snapshot)
                    recovered_finalization = True
                    used_finalization_recovery = True
                for key, value in usage.items():
                    total_usage[key] = total_usage.get(key, 0) + value
                current_snapshot = attempt_snapshot
                declared_changes = set(message.get("files_changed", [])) if message is not None else set()
                declared_mismatch = bool(message is not None and declared_changes != set(attempt_changes))
                if (
                    completed.returncode == 0
                    and message is not None
                    and task_activity
                    and not finalization_used_tools
                    and not declared_mismatch
                    and stream["failure"] is None
                ):
                    accepted = True
                    if message.get("status") == "success":
                        accepted_usage = dict(recovered_usage if recovered_usage is not None else usage)
                    break
                attempt_label = provider if stream_retry_count == 0 else f"{provider} retry"
                category = (
                    "finalization_used_tools"
                    if finalization_used_tools
                    else attempt_failure_category(completed, stream, message, invalid_result, task_activity, declared_mismatch)
                )
                attempts.append(
                    {
                        "provider": attempt_label,
                        "category": category,
                        "error": (
                            "declared files do not match the real workdir diff"
                            if declared_mismatch
                            else "same-session finalization unexpectedly used a task tool"
                            if finalization_used_tools
                            else str(stream["failure"])
                            if stream["failure"] is not None
                            else "invalid structured worker result"
                            if invalid_result or message is None
                            else "no task tool activity"
                            if not task_activity
                            else redact(completed.stderr or completed.stdout, 300)
                        ),
                    }
                )
                if attempt_changes:
                    side_effect_attempt = {"provider": provider, "files_changed": attempt_changes}
                    break
                if automatic:
                    circuit_failure(provider)
                retry_budget = int(provider_deadline - time.monotonic())
                if stream["failure"] is not None and stream_retry_count == 0 and retry_budget >= 5:
                    stream_retry_count += 1
                    used_stream_retry = True
                    continue
                break
        finally:
            fcntl.flock(lease_handle.fileno(), fcntl.LOCK_UN)
            lease_handle.close()
        if accepted or side_effect_attempt is not None:
            break
    duration = round(time.monotonic() - started, 2)
    after = workspace_snapshot(workdir)
    detected = changed_workspace_paths(before, after)
    attempt_failure_categories = [str(item["category"]) for item in attempts if isinstance(item.get("category"), str)]

    if side_effect_attempt is not None and not accepted:
        payload = {
            "status": "partial",
            "provider": provider,
            "profile": profile,
            "role": decision["role"],
            "summary": "DeepSeek changed the workspace but did not return a valid structured result; fallback stopped for main-model review.",
            "files_changed": detected,
            "tests": [],
            "risks": [
                "provider fallback stopped after workspace changes to avoid duplicate writes",
                f"{side_effect_attempt['provider']}: {attempts[-1]['error']}",
            ],
            "usage": total_usage,
            "accepted_usage": accepted_usage,
            "duration_seconds": duration,
            "stream_finish_reason": last_stream.get("finish_reason"),
            "stream_retry_count": 1 if used_stream_retry else 0,
            "finalization_recovery_count": 1 if used_finalization_recovery else 0,
            "attempt_failure_categories": attempt_failure_categories,
            "timeout_seconds": total_timeout,
        }
    elif not accepted:
        payload = {
            "status": "blocked" if provider_busy and all("already executing another Relay task" in item["error"] for item in attempts) else "error",
            "provider": provider,
            "profile": profile,
            "role": decision["role"],
            "summary": "All eligible DeepSeek providers are currently busy." if provider_busy and all("already executing another Relay task" in item["error"] for item in attempts) else "DeepSeek worker did not complete successfully.",
            "files_changed": detected,
            "tests": [],
            "risks": ["all DeepSeek providers failed", *[f"{item['provider']}: {item['error']}" for item in attempts]],
            "usage": total_usage,
            "accepted_usage": accepted_usage,
            "duration_seconds": duration,
            "stream_finish_reason": last_stream.get("finish_reason"),
            "stream_retry_count": 1 if used_stream_retry else 0,
            "finalization_recovery_count": 1 if used_finalization_recovery else 0,
            "attempt_failure_categories": attempt_failure_categories,
            "timeout_seconds": total_timeout,
        }
    else:
        payload = {
            "status": str(message.get("status", "success")),
            "provider": provider,
            "profile": profile,
            "role": decision["role"],
            "summary": redact_summary(str(message.get("summary", "")), workdir),
            "files_changed": sorted(set(message.get("files_changed", [])) | set(detected)),
            "tests": list(message.get("tests", [])),
            "risks": list(message.get("risks", []))
            + (["bounded same-provider stream retry was used"] if used_stream_retry else [])
            + (["provider fallback was used after an earlier DeepSeek route failed"] if attempt_index > 0 else []),
            "usage": total_usage,
            "accepted_usage": accepted_usage,
            "duration_seconds": duration,
            "stream_finish_reason": last_stream.get("finish_reason"),
            "stream_retry_count": 1 if used_stream_retry else 0,
            "finalization_recovery_count": 1 if used_finalization_recovery else 0,
            "attempt_failure_categories": attempt_failure_categories,
            "timeout_seconds": total_timeout,
        }
    payload["requested_provider"] = args.provider
    payload["fallback_attempted"] = automatic and provider != selected_provider
    if automatic and accepted:
        circuit_success(provider)
    if not args.no_record:
        record_run(payload, run_type="external_run", telemetry_scope=getattr(args, "telemetry_scope", "production"))
    return payload


def get_model_ids() -> tuple[list[str], str | None]:
    try:
        result = subprocess.run(
            ["codex", "debug", "models"],
            text=True,
            capture_output=True,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return [], type(exc).__name__
    if result.returncode != 0:
        return [], redact(result.stderr)
    try:
        payload = json.loads(result.stdout)
        return [str(item.get("slug")) for item in payload.get("models", [])], None
    except (json.JSONDecodeError, AttributeError):
        return [], "invalid model catalog JSON"


def build_catalog(output: Path) -> dict[str, Any]:
    result = subprocess.run(
        ["codex", "debug", "models"],
        text=True,
        capture_output=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        raise WorkerError("cannot read the live Codex model catalog")
    try:
        payload = json.loads(result.stdout)
        models = payload["models"]
        template = next(item for item in models if item.get("slug") == "gpt-5.6-terra")
    except (json.JSONDecodeError, KeyError, StopIteration, TypeError) as exc:
        raise WorkerError("live Codex model catalog has an unsupported shape") from exc
    candidate = copy.deepcopy(template)
    candidate.update(
        {
            "slug": "deepseek-v4-flash",
            "display_name": "DeepSeek V4 Flash",
            "description": "Text-only execution worker registered for custom Codex agent profiles.",
            "default_reasoning_level": "xhigh",
            "supported_reasoning_levels": [
                {"effort": "medium", "description": "Balanced execution"},
                {"effort": "high", "description": "Deeper execution reasoning"},
                {"effort": "xhigh", "description": "Maximum configured execution reasoning"},
            ],
            "priority": 100,
            "additional_speed_tiers": [],
            "service_tiers": [],
            "context_window": 128000,
            "max_context_window": 128000,
            "effective_context_window_percent": 90,
            "input_modalities": ["text"],
            "supports_image_detail_original": False,
            "supports_search_tool": False,
        }
    )
    models = [item for item in models if item.get("slug") != "deepseek-v4-flash"]
    models.append(candidate)
    rendered = json.dumps({"models": models}, ensure_ascii=False, indent=2) + "\n"
    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=output.parent, prefix=".model-catalog.", delete=False) as handle:
        handle.write(rendered)
        temporary = Path(handle.name)
    os.chmod(temporary, 0o600)
    os.replace(temporary, output)
    return {
        "status": "success",
        "catalog_path": str(output),
        "models": len(models),
        "deepseek_registered": True,
        "enabled_globally": False,
    }


def native_check(profile: str) -> dict[str, Any]:
    profile_path = CODEX_HOME / f"{profile}.config.toml"
    try:
        profile_config = tomllib.load(profile_path.open("rb"))
        catalog_path = str(profile_config["model_catalog_json"])
    except (OSError, KeyError, tomllib.TOMLDecodeError) as exc:
        return {"status": "error", "profile": profile, "error": f"invalid native test profile: {type(exc).__name__}"}
    result = subprocess.run(
        ["codex", "-c", f'model_catalog_json="{catalog_path}"', "debug", "models"],
        text=True,
        capture_output=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        return {"status": "error", "profile": profile, "error": redact(result.stderr)}
    try:
        payload = json.loads(result.stdout)
        models = [str(item.get("slug")) for item in payload.get("models", [])]
    except (json.JSONDecodeError, AttributeError):
        return {"status": "error", "profile": profile, "error": "invalid model catalog JSON"}
    return {
        "status": "success" if "deepseek-v4-flash" in models else "blocked",
        "profile": profile,
        "catalog_path": catalog_path,
        "deepseek_registered": "deepseek-v4-flash" in models,
        "model_count": len(models),
    }


def native_smoke(agent_type: str, workdir: Path, timeout: int) -> dict[str, Any]:
    provider_for_agent = {
        "explorer": "sensenova",
        "worker": "sensenova1",
        "default": "opencode-go",
        "deepseek-worker": "opencode-go",
    }
    expected_provider = provider_for_agent.get(agent_type)
    if expected_provider is None:
        raise WorkerError(f"unsupported native smoke agent: {agent_type}")
    log_offset = BRIDGE_LOG_PATH.stat().st_size if BRIDGE_LOG_PATH.is_file() else 0
    prompt = (
        f"Spawn exactly one `{agent_type}` subagent. Ask it to list only top-level names in the current "
        "directory without modifying files. Its final response must be exactly the required five-field JSON "
        "contract. Wait for it and close it. Your own final response must return that received contract verbatim "
        "as exactly the same JSON object; do not add prose or Markdown."
    )
    command = [
        "codex",
        "--strict-config",
        "--profile",
        NATIVE_TEST_PROFILE,
        "exec",
        "--ephemeral",
        "--skip-git-repo-check",
        "--sandbox",
        "read-only",
        "--output-schema",
        str(SCHEMA_PATH),
        "--json",
        prompt,
    ]
    completed = invoke_codex(command, workdir, timeout)
    spawned = waited = parent_received = False
    errors: list[str] = []
    for line in completed.stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") != "item.completed":
            continue
        item = event.get("item") or {}
        if item.get("type") == "collab_tool_call" and item.get("tool") == "spawn_agent":
            spawned = bool(item.get("receiver_thread_ids")) and item.get("status") == "completed"
        elif item.get("type") == "collab_tool_call" and item.get("tool") == "wait":
            waited = item.get("status") == "completed"
        elif item.get("type") == "agent_message":
            parent_received = True
    result, invalid_parent_result = native_result_contract(completed.stdout)
    result_contract_valid = result is not None
    if "Unknown model" in completed.stderr or "Unknown model" in completed.stdout:
        errors.append("unknown model")
    appended = ""
    if BRIDGE_LOG_PATH.is_file():
        with BRIDGE_LOG_PATH.open("rb") as handle:
            handle.seek(log_offset)
            appended = handle.read().decode("utf-8", errors="replace")
    provider_completed = f"completed backend={expected_provider}" in appended
    if not result_contract_valid:
        errors.append("missing valid structured result contract")
    status = "success" if completed.returncode == 0 and spawned and waited and parent_received and result_contract_valid and provider_completed else "blocked"
    if completed.returncode != 0:
        errors.append(redact(completed.stderr or completed.stdout, 300))
    return {
        "status": status,
        "agent_type": agent_type,
        "expected_provider": expected_provider,
        "spawned": spawned,
        "completed": waited,
        "parent_received": parent_received,
        "result_contract_valid": result_contract_valid,
        "invalid_parent_result": invalid_parent_result,
        "result_status": result.get("status") if result else None,
        "provider_completed": provider_completed,
        "errors": errors,
    }


def native_v1_canary(
    provider: str,
    workdir: Path,
    timeout: int,
    parent_model_override: str | None = None,
    role_layer: str = "full",
) -> dict[str, Any]:
    agent_for_provider = {"sensenova": "explorer", "sensenova1": "worker", "opencode-go": "default"}
    agent_type = agent_for_provider.get(provider)
    if agent_type is None:
        raise WorkerError(f"unsupported native canary provider: {provider}")
    if role_layer not in NATIVE_ROLE_LAYERS:
        raise WorkerError(f"unsupported native role layer: {role_layer}")
    try:
        with CONFIG_PATH.open("rb") as handle:
            config = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise WorkerError(f"cannot read Codex config: {type(exc).__name__}") from exc
    root_provider = str(config.get("model_provider", ""))
    parent_model = parent_model_override or str(config.get("model", ""))
    if root_provider != "openai-chatgpt":
        raise WorkerError("native canary requires root model_provider=openai-chatgpt")
    if not parent_model:
        raise WorkerError("native canary requires a configured parent model")
    catalog_source = Path(str(config.get("model_catalog_json", DEFAULT_CATALOG_PATH))).expanduser().resolve()
    codex = desktop_codex_binary()
    version_result = subprocess.run([str(codex), "--version"], text=True, capture_output=True, timeout=10, check=False)
    desktop_version = version_result.stdout.strip() if version_result.returncode == 0 else "unknown"
    nonce = secrets.token_hex(16)
    child_contract = {
        "status": "success",
        "summary": f"native-v1-canary:{nonce}",
        "files_changed": [],
        "tests": ["received bounded native V1 task"],
        "risks": [],
    }
    child_task = (
        "This is a read-only native V1 task-delivery canary. Do not call tools and do not modify files. "
        "Return exactly this JSON object with no Markdown or surrounding prose: "
        + json.dumps(child_contract, separators=(",", ":"))
    )
    prompt = native_v1_prompt(agent_type, child_task)
    config_before = file_fingerprint(CONFIG_PATH)
    state_before = state_db_snapshot()
    log_offset = BRIDGE_LOG_PATH.stat().st_size if BRIDGE_LOG_PATH.is_file() else 0
    with tempfile.TemporaryDirectory(prefix="deepseek-native-v1-") as temporary_dir:
        temporary_root = Path(temporary_dir)
        isolated_home = temporary_root / "codex-home"
        isolated_agents = isolated_home / "agents"
        isolated_workspace = temporary_root / "workspace"
        isolated_agents.mkdir(parents=True)
        isolated_workspace.mkdir()
        write_native_canary_config(CONFIG_PATH, isolated_home / "config.toml", provider)
        role_source = CODEX_HOME / "agents" / f"{agent_type}.toml"
        custom_role = write_native_role_layer(isolated_agents / role_source.name, agent_type, provider, role_layer, role_source)
        for auth_name in ("auth.json", "current_account"):
            auth_source = CODEX_HOME / auth_name
            if auth_source.is_file():
                (isolated_home / auth_name).symlink_to(auth_source)
        catalog = temporary_root / "models.json"
        build_v1_canary_catalog(catalog_source, catalog, parent_model)
        command = native_v1_command(codex, catalog, parent_model, prompt)
        isolated_env = dict(os.environ)
        isolated_env["CODEX_HOME"] = str(isolated_home)
        completed = invoke_codex(command, isolated_workspace, timeout, env=isolated_env)
        child_result, child_id, spawned, waited, nonce_verified = native_v1_child_result(completed.stdout, nonce)
        child_metadata = native_child_metadata(isolated_home, child_id)
        isolated_state_created = any(isolated_home.glob("state_*.sqlite"))
    provider_completed = bridge_provider_completed(BRIDGE_LOG_PATH, log_offset, provider)
    diagnostics = native_event_diagnostics(completed.stdout)
    config_unchanged = config_before == file_fingerprint(CONFIG_PATH)
    state_db_unchanged = state_before == state_db_snapshot()
    metadata_valid = bool(
        child_metadata
        and child_metadata.get("model_provider") == provider
        and child_metadata.get("model") == "deepseek-v4-flash"
        and str(child_metadata.get("agent_role", "")).lower() == agent_type.lower()
    )
    errors: list[str] = []
    warnings: list[str] = []
    if completed.returncode != 0:
        errors.append(redact(completed.stderr or completed.stdout, 300))
    if "Unknown model" in completed.stderr or "Unknown model" in completed.stdout:
        errors.append("unknown model")
    if not spawned:
        errors.append("native V1 spawn event not completed")
    if not waited:
        errors.append("native V1 wait event not completed")
    if child_result is None:
        errors.append("wait event did not contain a valid direct child result")
    elif not nonce_verified:
        errors.append("direct child result did not contain the assigned nonce")
    if not provider_completed:
        errors.append(f"bridge did not record completion for {provider}")
    if not metadata_valid:
        errors.append("isolated state DB did not confirm the expected child provider/model/role")
    if not isolated_state_created:
        errors.append("native V1 canary did not create an isolated state DB")
    if not config_unchanged:
        errors.append("Codex config changed during canary")
    if not state_db_unchanged:
        warnings.append("live Codex state DB changed concurrently; canary child state was confined to temporary CODEX_HOME")
    status = "success" if completed.returncode == 0 and not errors else "blocked"
    return {
        "status": status,
        "protocol": "v1",
        "desktop_codex_version": desktop_version,
        "root_model_provider": root_provider,
        "parent_model": parent_model,
        "agent_type": agent_type,
        "role_layer": role_layer,
        "custom_role": custom_role,
        "expected_provider": provider,
        "spawned": spawned,
        "waited": waited,
        "child_result_valid": child_result is not None,
        "nonce_verified": nonce_verified,
        "provider_completed": provider_completed,
        "child_metadata_valid": metadata_valid,
        "state_db_isolated": isolated_state_created,
        "config_unchanged": config_unchanged,
        "state_db_unchanged": state_db_unchanged,
        "errors": errors,
        "warnings": warnings,
        "diagnostics": diagnostics,
    }


